---
interface Props {
  href: string;
  nombre: string;
  precio: number;
  precioOriginal?: number;
  marca?: string;
  isNew?: boolean;
}

const { href, nombre, precio, precioOriginal, marca = 'BARZOL', isNew = false } = Astro.props;
---

<a
	href={href}
	class="product-card"
	style="background:white; border-radius:12px; border:1px solid var(--color-border-soft); cursor:pointer; overflow:hidden; text-decoration:none; display:block; transition:box-shadow 0.18s ease,transform 0.18s ease;"
>
	<div style="width:100%; aspect-ratio:1; background:var(--color-surface-muted); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
		<svg width="48" height="48" viewBox="0 0 24 24" fill="none">
			<rect x="3" y="3" width="18" height="18" rx="3" stroke="var(--color-border-muted)" stroke-width="1.5"></rect>
			<circle cx="8.5" cy="8.5" r="1.5" stroke="var(--color-border-muted)" stroke-width="1.5"></circle>
			<path d="M21 15l-5-5L5 21" stroke="var(--color-border-muted)" stroke-width="1.5" stroke-linejoin="round"></path>
		</svg>
		{isNew && (
			<div style="position:absolute; top:8px; left:8px; padding:3px 8px; background:var(--color-primary); color:white; font-size:9px; font-weight:700; border-radius:99px; letter-spacing:0.05em; z-index:2;">NUEVO</div>
		)}
	</div>
	<div style="padding:13px 15px 16px;">
		<div style="font-size:10px; font-weight:600; color:var(--color-text-muted); letter-spacing:0.07em; margin-bottom:5px; text-transform:uppercase;">{marca}</div>
		<div style="font-size:13.5px; font-weight:500; color:var(--color-text); line-height:1.4; margin-bottom:10px; min-height:38px;">{nombre}</div>
		{precioOriginal && (
			<div style="font-size:12px; color:var(--color-text-muted); text-decoration:line-through; margin-bottom:3px;">S/ {precioOriginal.toFixed(2)}</div>
		)}
		<div style="font-size:16px; font-weight:700; color:var(--color-primary);">S/ {precio.toFixed(2)}</div>
	</div>
</a>

<style>
	.product-card:hover {
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
		transform: translateY(-3px);
	}
</style>
