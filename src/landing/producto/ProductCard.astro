---
interface Props {
  href: string;
  nombre: string;
  precio: number;
  precioOriginal?: number;
  marca?: string;
  isNew?: boolean;
  foto?: string;
}

const { href, nombre, precio, precioOriginal, marca = 'BARZOL', isNew = false, foto } = Astro.props;
---

<a
	href={href}
	class="product-card"
	style="background:white; border-radius:12px; border:1px solid var(--color-border-soft); cursor:pointer; overflow:hidden; text-decoration:none; display:block; transition:box-shadow 0.18s ease,transform 0.18s ease;"
>
	<div class="product-card-media" data-state={foto ? 'loading' : 'empty'} style="width:100%; aspect-ratio:1; background:var(--color-surface-muted); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
		<div class="media-skeleton"></div>
		{foto && (
			<img
				src={foto}
				alt={nombre}
				loading="lazy"
				class="media-photo"
				onload="this.closest('.product-card-media').dataset.state='loaded'"
				onerror="this.closest('.product-card-media').dataset.state='error'"
			/>
		)}
		{isNew && (
			<div style="position:absolute; top:8px; left:8px; padding:3px 8px; background:var(--color-primary); color:white; font-size:9px; font-weight:700; border-radius:99px; letter-spacing:0.05em; z-index:2;">NUEVO</div>
		)}
	</div>
	<div style="padding:13px 15px 16px;">
		<div style="font-size:10px; font-weight:600; color:var(--color-text-muted); letter-spacing:0.07em; margin-bottom:5px; text-transform:uppercase;">{marca}</div>
		<div style="font-size:13.5px; font-weight:500; color:var(--color-text); line-height:1.4; margin-bottom:10px; height:38px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">{nombre}</div>
		<div style="display:flex; align-items:baseline; gap:7px;">
			<div style="font-size:16px; font-weight:700; color:var(--color-primary);">S/ {precio.toFixed(2)}</div>
			{precioOriginal && (
				<div style="font-size:12px; color:var(--color-text-muted); text-decoration:line-through;">S/ {precioOriginal.toFixed(2)}</div>
			)}
		</div>
	</div>
</a>

<style>
	.product-card:hover {
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
		transform: translateY(-3px);
	}

	/* Un solo diseño para "sin foto", "cargando" y "foto rota": un fondo
	   sutil con un brillo lento — sin íconos. Solo desaparece cuando la
	   foto carga bien de verdad. */
	.media-skeleton {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			100deg,
			var(--color-surface-muted) 42%,
			var(--color-border-faint) 50%,
			var(--color-surface-muted) 58%
		);
		background-size: 250% 100%;
		animation: media-shimmer 6s linear infinite;
		opacity: 1;
		transition: opacity 0.2s ease;
	}

	.media-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.25s ease;
		position: relative;
		z-index: 1;
	}

	.product-card-media[data-state='loaded'] .media-skeleton {
		opacity: 0;
	}
	.product-card-media[data-state='loaded'] .media-photo {
		opacity: 1;
	}

	@keyframes media-shimmer {
		0% {
			background-position: 250% 0;
		}
		100% {
			background-position: -250% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.media-skeleton {
			animation: none;
		}
	}
</style>
