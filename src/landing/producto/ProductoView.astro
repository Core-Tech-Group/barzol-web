---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import Breadcrumb from '@landing/shared/Breadcrumb.astro';
import ProductCarousel from './ProductCarousel.astro';
import WhatsAppIcon from '@landing/shared/WhatsAppIcon.astro';
import type { Product } from '@shared/types';
import { getProductosByCategoria } from '@shared/lib/productos/productoService';
import { getCategorias } from '@shared/lib/categorias/categoriaService';
import { productoUrl } from '@shared/lib/productos/productoUrl';

interface Props {
  producto: Product;
}

// El lookup por `code` + el redirect si no existe pasan por la página
// (src/pages/producto/[slugCode].astro) — `Astro.redirect()` solo corta la
// respuesta de verdad quien lo llama es el nivel de página/ruta, no un
// componente anidado como este.
const { producto } = Astro.props;

const categoriasDb = await getCategorias();
const categoryById = new Map(categoriasDb.map((c) => [c.id, c]));

const nombre = producto.nombre;
const precio = producto.precio;
const precioOriginal = producto.precioOriginal;
const descuentoPct = precioOriginal ? Math.round((1 - precio / precioOriginal) * 100) : 0;
const caracteristicas = producto.caracteristicas;
const fotos = producto.fotos;

// El breadcrumb y "más productos" navegan por categoría (instrumento) — la
// misma que se administra en /admin/categorias, no una taxonomía alternativa.
const categoria = producto.categoriaId ? categoryById.get(producto.categoriaId) : undefined;
const breadcrumbMiddle = categoria ? { label: categoria.nombre, href: `/catalogo/${categoria.slug}` } : null;

// Solo se piden los 4 productos que esta sección muestra, del mismo
// instrumento (su id + el de cada subcategoría), excluyendo el actual —
// no toda la tabla product.
const leafIds = categoria ? [categoria.id, ...categoria.subcategorias.map((s) => s.id)] : [];
const suggestedDb = leafIds.length ? await getProductosByCategoria(leafIds, { excludeId: producto.id, limit: 4 }) : [];
const suggested = suggestedDb.map((p) => ({ href: productoUrl(p), nombre: p.nombre, precio: p.precio, precioOriginal: p.precioOriginal ?? undefined, foto: p.fotos[0] }));
---

<PublicLayout title={`${nombre} — Barzol`}>
	<Breadcrumb
		items={[
			{ label: 'Inicio', href: '/' },
			...(breadcrumbMiddle ? [breadcrumbMiddle] : []),
			{ label: nombre },
		]}
	/>

	<!-- PRODUCT DETAIL -->
	<div class="bz-section-wrap" style="max-width:1200px; margin:0 auto; padding:24px 32px 32px;">
		<div class="bz-product-grid" style="display:grid; grid-template-columns:612px 1fr; gap:52px; align-items:start; background:white; border-radius:16px; border:1px solid var(--color-border-soft); box-shadow:0 4px 20px rgba(0,0,0,0.06); padding:28px;">

			<!-- GALERÍA: el layout (miniatura chica + foto grande) es siempre el
			     mismo — la cantidad de miniaturas sigue a producto.fotos, no un
			     número fijo, pero se muestra la columna aunque haya una sola foto.
			     Click en una miniatura cambia la foto principal. -->
			<div class="bz-gallery" style="display:flex; gap:12px; align-items:flex-start;">
				{fotos.length > 0 && (
					<div class="bz-thumbs" style="display:flex; flex-direction:column; gap:10px;">
						{fotos.map((foto, i) => (
							<button
								type="button"
								class="bz-thumb"
								class:list={{ 'bz-thumb-active': i === 0 }}
								data-photo-thumb
								data-src={foto}
								aria-label={`Ver foto ${i + 1} de ${fotos.length}`}
								style="width:80px; height:80px; padding:0; border-radius:0; flex-shrink:0; overflow:hidden; background:var(--color-surface-muted); cursor:pointer; border:1px solid transparent;"
							>
								<img src={foto} alt="" loading="lazy" style="width:100%; height:100%; object-fit:cover; display:block;" />
							</button>
						))}
					</div>
				)}
				<div class="bz-main-img-wrap" data-gallery-main data-state={fotos.length ? 'loading' : 'empty'} style="width:520px; height:540px; border-radius:0; overflow:hidden; background:var(--color-surface-muted); position:relative; cursor:crosshair; flex-shrink:0;">
					<div class="media-skeleton"></div>
					{fotos.length > 0 && (
						<img
							data-main-photo
							src={fotos[0]}
							alt={nombre}
							class="media-photo"
							onload="this.closest('[data-gallery-main]').dataset.state='loaded'"
							onerror="this.closest('[data-gallery-main]').dataset.state='error'"
						/>
					)}
				</div>
			</div>

			<!-- INFO -->
			<div style="padding-top:4px;">
				<div style="font-size:10px; font-weight:700; letter-spacing:0.1em; color:var(--color-text-faint); text-transform:uppercase; margin-bottom:8px;">BARZOL</div>
				<h1 style="font-size:24px; font-weight:700; color:var(--color-text); line-height:1.25; margin-bottom:12px;">{nombre}</h1>

				<div style="display:flex; align-items:center; gap:12px; margin-bottom:22px; padding-bottom:22px; border-bottom:1px solid var(--color-surface-muted);">
					<span style="font-size:30px; font-weight:700; color:var(--color-primary);">S/ {precio.toFixed(2)}</span>
					{precioOriginal && (
						<>
							<span style="font-size:16px; color:var(--color-text-faint); text-decoration:line-through;">S/ {precioOriginal.toFixed(2)}</span>
							<span style="padding:3px 10px; background:var(--color-danger-bg); color:var(--color-danger); font-size:11px; font-weight:700; border-radius:99px;">{descuentoPct}% OFF</span>
						</>
					)}
				</div>
				<p style="font-size:13.5px; color:var(--color-text-body); line-height:1.7; margin-bottom:12px;">{producto.descripcion}</p>
				<ul style="list-style:none; display:flex; flex-direction:column; gap:7px; margin-bottom:22px; padding:0;">
					{caracteristicas.map((bullet) => (
						<li style="display:flex; align-items:center; gap:9px; font-size:13px; color:var(--color-text-body);">
							<span style="width:6px; height:6px; border-radius:50%; background:var(--color-primary); flex-shrink:0;"></span>
							{bullet}
						</li>
					))}
				</ul>

				<div style="display:flex; flex-direction:row; gap:8px; margin-bottom:24px; flex-wrap:wrap;">
					<a href={`https://wa.me/51950759032?text=${encodeURIComponent(`Hola, me interesa: ${nombre}`)}`} target="_blank" rel="noopener" class="product-cta-primary" style="display:inline-flex; align-items:center; gap:7px; padding:11px 15px; background:var(--color-whatsapp); color:white; font-size:12.5px; font-weight:600; text-decoration:none; border-radius:9px; box-shadow:0 3px 12px rgba(var(--color-whatsapp-rgb),0.3); white-space:nowrap;">
						<WhatsAppIcon size={16} fill="white" />
						Consultar por WhatsApp
					</a>
					{breadcrumbMiddle && (
						<a href={breadcrumbMiddle.href} class="product-cta-secondary" style="display:inline-flex; align-items:center; padding:11px 13px; background:white; border:1px solid var(--color-border); border-radius:9px; font-size:12.5px; font-weight:500; color:var(--color-text-soft); text-decoration:none; white-space:nowrap;">Ver más de {breadcrumbMiddle.label}</a>
					)}
				</div>
				<div style="background:var(--color-surface-soft); border:1px solid var(--color-border-soft); border-radius:10px; padding:14px 18px; display:flex; flex-direction:column; gap:10px;">
					<div style="display:flex; align-items:center; gap:10px; font-size:13px; color:var(--color-text-soft);">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="1" y="3" width="15" height="13" rx="2" stroke="var(--color-primary)" stroke-width="1.8"></rect><path d="M16 8h3l3 4v5h-6V8z" stroke="var(--color-primary)" stroke-width="1.8"></path><circle cx="5.5" cy="18.5" r="1.5" stroke="var(--color-primary)" stroke-width="1.5"></circle><circle cx="18.5" cy="18.5" r="1.5" stroke="var(--color-primary)" stroke-width="1.5"></circle></svg>
						Envío a nivel nacional e internacional
					</div>
					<div style="display:flex; align-items:center; gap:10px; font-size:13px; color:var(--color-text-soft);">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="var(--color-primary)" stroke-width="1.8" stroke-linejoin="round"></path></svg>
						Personalización disponible (nombre, logo, grabado)
					</div>
					<div style="display:flex; align-items:center; gap:10px; font-size:13px; color:var(--color-text-soft);">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.13 1.18 2 2 0 012.11 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						Atención directa por WhatsApp — respuesta rápida
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- PRODUCTOS SUGERIDOS: solo si hay al menos 2, para no mostrar un carrusel con un único producto.
	     Sin padding propio arriba/abajo — ProductCarousel ya trae su margin-top, y Footer su
	     margin-top: sumarles otro relleno acá duplicaba el espacio antes del título y antes del footer. -->
	{suggested.length >= 2 && (
		<div class="bz-section-wrap" style="max-width:1200px; margin:0 auto; padding:0 32px;">
			<div style="border-top:1px solid var(--color-border-soft);">
				<ProductCarousel title={`Más productos de ${breadcrumbMiddle?.label ?? ''}`} products={suggested} />
			</div>
		</div>
	)}
</PublicLayout>

<style>
	.product-cta-primary:hover {
		background: var(--color-whatsapp-dark);
	}
	.product-cta-secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	@media (max-width: 860px) {
		.bz-product-grid {
			grid-template-columns: 1fr !important;
			gap: 24px !important;
			padding: 18px !important;
		}
		.bz-gallery {
			flex-direction: column-reverse !important;
		}
		.bz-main-img-wrap {
			width: 100% !important;
			height: auto !important;
			aspect-ratio: 520 / 540 !important;
		}
		.bz-thumbs {
			flex-direction: row !important;
			overflow-x: auto !important;
		}
		.bz-thumb {
			width: 64px !important;
			height: 64px !important;
			flex-shrink: 0;
		}
	}

	.bz-thumb:hover {
		border-color: var(--color-border) !important;
	}
	.bz-thumb-active {
		border-color: var(--color-primary) !important;
	}
	.bz-thumb img {
		transition: transform 0.18s ease;
	}
	.bz-thumb:hover img {
		transform: scale(1.06);
	}

	/* Mismo diseño sutil de ProductCard para "sin foto"/"cargando"/"foto
	   rota" — sin íconos, solo un brillo lento y parejo. */
	.media-skeleton {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			100deg,
			var(--color-surface-muted) 42%,
			var(--color-border-faint) 50%,
			var(--color-surface-muted) 58%
		);
		background-size: 250% 100%;
		animation: media-shimmer 6s linear infinite;
		opacity: 1;
		transition: opacity 0.2s ease;
	}
	.media-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.25s ease;
		position: relative;
		z-index: 1;
	}
	[data-gallery-main][data-state='loaded'] .media-skeleton {
		opacity: 0;
	}
	[data-gallery-main][data-state='loaded'] .media-photo {
		opacity: 1;
	}
	@keyframes media-shimmer {
		0% {
			background-position: 250% 0;
		}
		100% {
			background-position: -250% 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.media-skeleton {
			animation: none;
		}
	}
</style>

<script>
	function initGallery() {
		document.querySelectorAll<HTMLElement>('.bz-gallery').forEach((gallery) => {
			if (gallery.dataset.wired) return;
			gallery.dataset.wired = 'true';

			const mainWrap = gallery.querySelector<HTMLElement>('[data-gallery-main]');
			const mainImg = gallery.querySelector<HTMLImageElement>('[data-main-photo]');
			const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-photo-thumb]');
			if (!mainWrap || !mainImg) return;

			thumbs.forEach((thumb) => {
				thumb.addEventListener('click', () => {
					const src = thumb.dataset.src;
					if (!src || src === mainImg.src) return;

					mainWrap.dataset.state = 'loading';
					mainImg.src = src;

					thumbs.forEach((t) => t.classList.toggle('bz-thumb-active', t === thumb));
				});
			});

			// Lupa: acercarse a la foto principal la agranda 2x y sigue el mouse.
			mainWrap.addEventListener('mouseenter', () => {
				mainImg.style.transition = 'transform 0.2s ease, opacity 0.25s ease';
				mainImg.style.transform = 'scale(2)';
			});
			mainWrap.addEventListener('mousemove', (e) => {
				const rect = mainWrap.getBoundingClientRect();
				const x = (((e.clientX - rect.left) / rect.width) * 100).toFixed(2);
				const y = (((e.clientY - rect.top) / rect.height) * 100).toFixed(2);
				mainImg.style.transformOrigin = `${x}% ${y}%`;
			});
			mainWrap.addEventListener('mouseleave', () => {
				mainImg.style.transition = 'transform 0.45s cubic-bezier(0.25,0.46,0.45,0.94), opacity 0.25s ease';
				mainImg.style.transform = 'scale(1)';
				const onEnd = () => {
					mainImg.style.transformOrigin = '50% 50%';
					mainImg.removeEventListener('transitionend', onEnd);
				};
				mainImg.addEventListener('transitionend', onEnd);
			});
		});
	}

	document.addEventListener('astro:page-load', initGallery);
	initGallery();
</script>
