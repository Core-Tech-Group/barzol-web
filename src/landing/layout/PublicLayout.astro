---
import '@shared/styles/tokens.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@landing/shared/Header.astro';
import Footer from '@landing/shared/Footer.astro';
import WhatsAppButton from '@landing/shared/WhatsAppButton.astro';

interface Props {
  title?: string;
  /** Resumen de la página para buscadores y para la tarjeta de un link compartido. */
  descripcion?: string;
  /** URL absoluta de la imagen de esa tarjeta (WhatsApp, Facebook...). Sin ella, sale solo texto. */
  imagen?: string;
}

const {
  title = 'Barzol',
  descripcion = 'Accesorios exclusivos para tu instrumento musical, diseñados y fabricados con tecnología 3D.',
  imagen,
} = Astro.props;

// Open Graph: lo que leen WhatsApp, Facebook, etc. al pegar un link del sitio
// para armar la vista previa. La URL va sin query string para que todas las
// variantes de una página compartan la misma tarjeta.
const urlCanonica = new URL(Astro.url.pathname, Astro.url.origin).href;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
		/>
		<title>{title}</title>
		<meta name="description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Barzol" />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={urlCanonica} />
		{imagen && <meta property="og:image" content={imagen} />}
		<meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />
		<ClientRouter />
	</head>
	<body>
		<div style="min-height:100vh; background:var(--color-bg);">
			<Header />
			<slot />
			<WhatsAppButton />
			<Footer transition:persist="site-footer" />
		</div>
	</body>
</html>
