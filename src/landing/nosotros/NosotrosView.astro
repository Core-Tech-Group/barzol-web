---
import PublicLayout from '@landing/layout/PublicLayout.astro';

const confianza = [
  { key: 'star', label: 'Diseño exclusivo' },
  { key: 'truck', label: 'Envío nacional e internacional' },
  { key: 'pencil', label: 'Personalización disponible' },
] as const;
---

<PublicLayout title="Nosotros — Barzol">
	<!-- HERO NOSOTROS — azul pizarra con un halo azul suave detrás de la marca:
	     la marca (SVG blanco translúcido) gana contraste sin volverse protagonista. -->
	<div class="bz-nos-hero">
		<div class="bz-nos-halo" aria-hidden="true"></div>
		<img src="/nosotros-watermark.svg" alt="" aria-hidden="true" class="bz-nos-marca" />
		<div style="position:relative; max-width:680px; margin:0 auto;">
			<div class="bz-nos-somos">Somos</div>
			<h1 class="bz-nos-titulo">BARZOL</h1>
			<p class="bz-nos-lema">Transformamos tus ideas con tecnología 3D</p>
			<p class="bz-nos-desc">Diseñamos con ingeniería aplicada y fabricamos con tecnología 3D para crear soluciones reales.</p>
		</div>
	</div>

	<!-- CONFIANZA -->
	<div style="background:white; padding:40px 32px 44px; text-align:center;">
		<div style="max-width:680px; margin:0 auto;">
			{/* Las columnas salen de la lista: con un número fijo, quitar un
			    recuadro dejaba un hueco vacío al final. El ancho máximo escala
			    igual, así cada recuadro conserva su tamaño (~170px). */}
			<div class="bz-confianza-grid" style={`display:grid; grid-template-columns:repeat(${confianza.length},1fr); gap:14px; max-width:${confianza.length * 184}px; margin:0 auto;`}>
				{confianza.map((item) => (
					<div class="bz-confianza-item" style="background:white; border:1px solid var(--color-border-soft); border-radius:14px; padding:22px 14px; display:flex; flex-direction:column; align-items:center; gap:12px;">
						<div style="width:44px; height:44px; background:var(--color-primary-light); border-radius:11px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
							{item.key === 'star' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z" stroke="var(--color-primary)" stroke-width="1.7" stroke-linejoin="round"></path></svg>
							)}
							{item.key === 'truck' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="1" y="3" width="15" height="13" rx="2" stroke="var(--color-primary)" stroke-width="1.7" stroke-linejoin="round"></rect><path d="M16 8h3l3 4v5h-6V8z" stroke="var(--color-primary)" stroke-width="1.7" stroke-linejoin="round"></path><circle cx="5.5" cy="18.5" r="1.5" stroke="var(--color-primary)" stroke-width="1.4"></circle><circle cx="18.5" cy="18.5" r="1.5" stroke="var(--color-primary)" stroke-width="1.4"></circle></svg>
							)}
							{item.key === 'pencil' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 20h9" stroke="var(--color-primary)" stroke-width="1.7" stroke-linecap="round"></path><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke="var(--color-primary)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
							)}
						</div>
						<span style="font-size:12px; font-weight:600; color:var(--color-text-soft); text-align:center; line-height:1.35;">{item.label}</span>
					</div>
				))}
			</div>
		</div>
	</div>

	<!-- HISTORIA -->
	<!--div style="max-width:1200px; margin:0 auto; padding:64px 32px;">
		<div style="display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">
			<div>
				<div style="font-size:10px; font-weight:700; letter-spacing:0.14em; color:var(--color-primary); text-transform:uppercase; margin-bottom:12px;">Nuestra historia</div>
				<h2 style="font-size:30px; font-weight:700; color:var(--color-text); line-height:1.2; margin-bottom:20px;">Tecnología al servicio de la música</h2>
				<p style="font-size:14px; color:var(--color-text-muted); line-height:1.75; margin-bottom:20px;">Diseñamos con software CAD/CAE y fabricamos con impresión 3D para estudiantes, orquestas, bandas sinfónicas y músicos independientes. Nuestros productos son exclusivos y están protegidos por patentes.</p>
				<p style="font-size:15px; color:var(--color-text); font-weight:500; line-height:1.7; margin-bottom:28px; padding-left:16px; border-left:3px solid var(--color-primary);">"No solo fabricamos accesorios: damos vida a las ideas de los músicos, impulsando la creatividad y la pasión que los inspira."</p>
				<div style="display:flex; gap:12px;">
					<a href="https://wa.me/51950759032" target="_blank" rel="noopener" class="nosotros-cta-primary" style="display:inline-flex; align-items:center; gap:8px; padding:12px 22px; background:var(--color-primary); color:white; font-size:13.5px; font-weight:600; text-decoration:none; border-radius:9px; box-shadow:0 6px 20px rgba(var(--color-primary-rgb),0.26);">Contáctanos</a>
					<a href="/" class="nosotros-cta-secondary" style="display:inline-flex; align-items:center; gap:8px; padding:12px 22px; background:white; color:var(--color-text-soft); font-size:13.5px; font-weight:500; text-decoration:none; border-radius:9px; border:1.5px solid var(--color-border);">Ver productos</a>
				</div>
			</div>
			<div style="position:relative; height:380px; border-radius:16px; overflow:hidden; background:var(--color-surface-muted); border:1px solid var(--color-border-soft); display:flex; align-items:center; justify-content:center; color:var(--color-text-faint); font-size:13px; text-align:center; padding:20px;">
				Foto del taller / equipo
			</div>
		</div>
	</div>

	-->

	<!-- MISIÓN Y VISIÓN — mismo gris que el fondo de la página: se funde con el
	     margen superior del footer (64px) en vez de dejar una franja suelta. -->
	<div style="background:var(--color-bg); padding:56px 32px 8px;">
		<div style="max-width:1200px; margin:0 auto;">
			<div style="text-align:center; margin-bottom:44px;">
				<div style="font-size:10px; font-weight:700; letter-spacing:0.14em; color:var(--color-primary); text-transform:uppercase; margin-bottom:12px;">Hacia dónde vamos</div>
				<h2 style="font-size:28px; font-weight:700; color:var(--color-text);">Misión y visión</h2>
			</div>
			<div class="bz-mision-grid" style="max-width:860px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:20px;">
				<div style="background:white; border-radius:14px; border:1px solid var(--color-border-soft); box-shadow:0 2px 10px rgba(16,24,40,0.04); padding:28px 26px; text-align:left;">
					<div style="width:44px; height:44px; background:var(--color-primary-light); border-radius:11px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="var(--color-primary)" stroke-width="1.7"></circle><circle cx="12" cy="12" r="5" stroke="var(--color-primary)" stroke-width="1.7"></circle><circle cx="12" cy="12" r="1" fill="var(--color-primary)"></circle></svg>
					</div>
					<div style="font-size:10px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-primary); margin-bottom:10px;">Misión</div>
					<p style="font-size:14px; color:var(--color-text-body); line-height:1.7;">
					Diseñar y fabricar soluciones funcionales e innovadoras mediante ingeniería aplicada y tecnología 3D, transformando ideas y necesidades en productos reales y de alto valor.					
				</p>
				</div>
				<div style="background:white; border-radius:14px; border:1px solid var(--color-border-soft); box-shadow:0 2px 10px rgba(16,24,40,0.04); padding:28px 26px; text-align:left;">
					<div style="width:44px; height:44px; background:var(--color-primary-light); border-radius:11px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="var(--color-primary)" stroke-width="1.7" stroke-linejoin="round"></path><circle cx="12" cy="12" r="3.2" stroke="var(--color-primary)" stroke-width="1.7"></circle></svg>
					</div>
					<div style="font-size:10px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-primary); margin-bottom:10px;">Visión</div>
					<p style="font-size:14px; color:var(--color-text-body); line-height:1.7;">
					Ser una empresa líder en fabricación aditiva de accesorios musicales y en el desarrollo de soluciones de ingeniería mediante tecnología 3D, reconocida por su innovación y calidad, con presencia a nivel internacional.
					</p>
				</div>
			</div>
		</div>
	</div>

</PublicLayout>

<style>
	.nosotros-cta-primary:hover {
		background: var(--color-primary-dark);
	}
	.nosotros-cta-secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.bz-nos-hero {
		position: relative;
		padding: 100px 32px 72px;
		text-align: center;
		overflow: hidden;
		/* Punto medio (OKLab) entre el pizarra original del sitio
		   (--gradient-hero-dark: #0b1928 → #2b3a57) y un azul más saturado
		   (#0e1b3a → #1b2d55): conserva el subtono gris, un poco más oscuro. */
		background: linear-gradient(135deg, #0c1a31, #233456);
	}
	.bz-nos-halo {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 50%, rgba(96, 165, 250, 0.24) 0%, rgba(96, 165, 250, 0.09) 28%, rgba(96, 165, 250, 0) 55%);
		pointer-events: none;
	}
	.bz-nos-somos {
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: rgba(255, 255, 255, 0.9);
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.bz-nos-titulo {
		font-size: 76px;
		font-weight: 800;
		color: white;
		line-height: 1;
		letter-spacing: -0.01em;
		margin-bottom: 16px;
	}
	.bz-nos-lema {
		font-size: 18px;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.92);
		margin-bottom: 10px;
	}
	.bz-nos-desc {
		font-size: 14.5px;
		color: rgba(255, 255, 255, 0.8);
		line-height: 1.65;
		max-width: 460px;
		margin: 0 auto;
	}
	.bz-nos-marca {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		height: 330px;
		width: auto;
		pointer-events: none;
		user-select: none;
	}

	/* Móvil: las tres tarjetas de confianza no entran en una fila (el texto
	   se salía de la pantalla): van una debajo de otra, con el ícono a la
	   izquierda. */
	@media (max-width: 560px) {
		/* Textos del hero a escala de celular: el título ya no ocupa todo el
		   ancho y el lema entra en una línea. */
		.bz-nos-hero {
			padding: 56px 20px 48px;
		}
		.bz-nos-marca {
			height: 260px;
		}
		.bz-nos-somos {
			font-size: 12px;
			letter-spacing: 0.2em;
		}
		.bz-nos-titulo {
			font-size: 52px;
			margin-bottom: 12px;
		}
		/* Escala con el ancho para entrar en una línea hasta ~340px; si no
		   entra, balance reparte las palabras en vez de dejar "3D" sola. */
		.bz-nos-lema {
			font-size: clamp(13.5px, 3.85vw, 15px);
			margin-bottom: 8px;
			text-wrap: balance;
		}
		.bz-nos-desc {
			font-size: 13.5px;
			line-height: 1.6;
			max-width: 320px;
			text-wrap: balance;
		}
		.bz-confianza-grid {
			grid-template-columns: 1fr !important;
			max-width: 340px !important;
			gap: 10px !important;
		}
		.bz-confianza-item {
			flex-direction: row !important;
			padding: 14px 16px !important;
			text-align: left;
		}
		.bz-confianza-item span {
			text-align: left !important;
		}
	}

	/* En pantalla angosta, misión y visión una debajo de la otra. */
	@media (max-width: 640px) {
		.bz-mision-grid {
			grid-template-columns: 1fr !important;
		}
	}
</style>
