---
---

<footer style="background:var(--color-navy-dark); margin-top:64px; padding:52px 0 28px;">
	<div style="max-width:1200px; margin:0 auto; padding:0 32px;">

		<div class="bz-footer-grid" style="display:grid; grid-template-columns:1.5fr 1fr 1fr 1fr; gap:40px; margin-bottom:44px;">

			<!-- Brand -->
			<div class="bz-footer-brand">
				<div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
					<!-- Logo -->
					<a href="/" class="bz-logo-link" style="display:flex; align-items:center; text-decoration:none; flex-shrink:0;">
						<img src="/favicon-white.svg" alt="Barzol" width="277" height="23" class="bz-logo-img" style="height:23px; width:auto; display:block;" />
					</a>

					<span style="font-size:17px; font-weight:700; color:white; letter-spacing:0.01em;">BARZOL</span>
				</div>
				<p style="font-size:13px; color:rgba(255,255,255,0.55); line-height:1.65; margin-bottom:12px;">Accesorios musicales innovadores fabricados con tecnología de impresión 3D. Productos exclusivos y patentados.</p>
				<a href="/nosotros" class="bz-footer-nosotros" style="display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:600; color:white; text-decoration:none;">
					Nosotros
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
			</div>

			<!-- Contacto -->
			<div>
				<h4 style="font-size:12.5px; font-weight:600; color:white; margin-bottom:16px; letter-spacing:0.04em; text-transform:uppercase;">Contáctanos</h4>
				<div style="display:flex; flex-direction:column; gap:11px;">
					<a href="tel:950759032" style="display:flex; align-items:center; gap:9px; font-size:13px; color:rgba(255,255,255,0.6); text-decoration:none;">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.13 1.18 2 2 0 012.11 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z" stroke="rgba(255,255,255,0.6)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						950 759 032
					</a>
					<a href="mailto:atencioncliente@barzol.com" style="display:flex; align-items:center; gap:9px; font-size:13px; color:rgba(255,255,255,0.6); text-decoration:none;">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="rgba(255,255,255,0.6)" stroke-width="1.8" stroke-linejoin="round"></path><polyline points="22,6 12,13 2,6" stroke="rgba(255,255,255,0.6)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
						atencioncliente@barzol.com
					</a>
				</div>
			</div>

			<!-- Social -->
			<div>
				<h4 style="font-size:12.5px; font-weight:600; color:white; margin-bottom:16px; letter-spacing:0.04em; text-transform:uppercase;">Síguenos en</h4>
				<div style="display:flex; flex-direction:column; gap:11px;">
					<a href="https://www.facebook.com/share/1KDMp3hv4y" target="_blank" rel="noopener noreferrer" style="display:flex; align-items:center; gap:9px; font-size:13px; color:rgba(255,255,255,0.6); text-decoration:none;">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" stroke="rgba(255,255,255,0.6)" stroke-width="1.8" stroke-linejoin="round"></path></svg>
						Facebook
					</a>
					<a href="https://www.tiktok.com/@barzol3dmusic" target="_blank" rel="noopener noreferrer" style="display:flex; align-items:center; gap:9px; font-size:13px; color:rgba(255,255,255,0.6); text-decoration:none;">
					<svg width="12" height="13" viewBox="0 0 12 13" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M10.1149 3.26086C9.53341 3.13299 9.00738 2.8242 8.61228 2.37879C8.21718 1.93339 7.97334 1.37428 7.91574 0.781691V0.525024H5.90324V8.49919C5.848 8.9048 5.64707 9.27646 5.33793 9.54481C5.0288 9.81315 4.63259 9.95985 4.22324 9.95752C3.77612 9.95752 3.34733 9.77991 3.03117 9.46375C2.71502 9.1476 2.5374 8.7188 2.5374 8.27169C2.5374 7.82458 2.71502 7.39578 3.03117 7.07963C3.34733 6.76347 3.77612 6.58586 4.22324 6.58586C4.38657 6.58586 4.53824 6.60919 4.68407 6.64419V4.61419C4.53122 4.59485 4.37731 4.58511 4.22324 4.58502C3.24238 4.58502 2.30169 4.97467 1.60812 5.66824C0.914547 6.36181 0.524902 7.3025 0.524902 8.28336C0.524902 8.76903 0.620562 9.24995 0.806421 9.69865C0.99228 10.1474 1.2647 10.5551 1.60812 10.8985C2.30169 11.592 3.24238 11.9817 4.22324 11.9817C5.20308 11.9801 6.14227 11.5898 6.83458 10.8964C7.52689 10.203 7.91574 9.26321 7.91574 8.28336V4.42752C8.7294 5.00778 9.70471 5.31792 10.7041 5.31419V3.28419C10.5074 3.29696 10.3099 3.28913 10.1149 3.26086Z" stroke="white" stroke-opacity="0.6" stroke-width="1.05"/>
					</svg>
						TikTok
					</a>
					<a href="https://www.instagram.com/barzol3dmusic?igsi=YnFwN3g4dHRxNGN6" target="_blank" rel="noopener noreferrer" style="display:flex; align-items:center; gap:9px; font-size:13px; color:rgba(255,255,255,0.6); text-decoration:none;">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="rgba(255,255,255,0.6)" stroke-width="1.8"></rect><circle cx="12" cy="12" r="4.2" stroke="rgba(255,255,255,0.6)" stroke-width="1.8"></circle><circle cx="17.4" cy="6.6" r="1.1" fill="rgba(255,255,255,0.6)"></circle></svg>
						Instagram
					</a>
				</div>
			</div>

			<!-- Payments -->
			<div>
				<h4 style="font-size:12.5px; font-weight:600; color:white; margin-bottom:16px; letter-spacing:0.04em; text-transform:uppercase;">Medios de pago</h4>
				<div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:8px; max-width:220px;">
					<div style="padding:7px 0; background:rgba(255,255,255,0.09); border:1px solid rgba(255,255,255,0.14); border-radius:6px; font-size:11px; font-weight:600; color:rgba(255,255,255,0.75); letter-spacing:0.03em; text-align:center;">Visa</div>
					<div style="padding:7px 0; background:rgba(255,255,255,0.09); border:1px solid rgba(255,255,255,0.14); border-radius:6px; font-size:11px; font-weight:600; color:rgba(255,255,255,0.75); letter-spacing:0.03em; text-align:center;">Mastercard</div>
					<div style="padding:7px 0; background:rgba(255,255,255,0.09); border:1px solid rgba(255,255,255,0.14); border-radius:6px; font-size:11px; font-weight:600; color:rgba(255,255,255,0.75); letter-spacing:0.03em; text-align:center;">Yape</div>
					<div style="padding:7px 0; background:rgba(255,255,255,0.09); border:1px solid rgba(255,255,255,0.14); border-radius:6px; font-size:11px; font-weight:600; color:rgba(255,255,255,0.75); letter-spacing:0.03em; text-align:center;">Plin</div>
				</div>
			</div>

		</div>

		<!-- Bottom bar -->
		<div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:20px; display:flex; align-items:center; justify-content:center;">
			<p style="font-size:12px; color:rgba(255,255,255,0.35);">© 2026 Barzol 3D Industry S.A.C. Todos los derechos reservados.</p>
		</div>

	</div>
</footer>

<style>
	.bz-footer-nosotros:hover {
		color: rgba(255, 255, 255, 0.8);
	}

	@media (max-width: 768px) {
		.bz-footer-grid {
			grid-template-columns: 1fr 1fr !important;
			gap: 28px !important;
		}
		.bz-footer-brand {
			grid-column: 1 / -1 !important;
		}
	}
	@media (max-width: 480px) {
		.bz-footer-grid {
			grid-template-columns: 1fr !important;
		}
	}
</style>
