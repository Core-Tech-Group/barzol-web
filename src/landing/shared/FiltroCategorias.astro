---
// Filtro de categorías del catálogo y de la búsqueda. En desktop es la barra
// lateral fija. En pantallas angostas (≤860px), donde va encima de los
// productos, arranca plegado en una línea para no empujarlos hacia abajo y se
// despliega tocando el encabezado. El estado lo guarda un checkbox oculto: sin
// JS, así funciona igual con la navegación del ClientRouter.
interface Categoria {
  id: string;
  nombre: string;
  slug: string;
}

interface Props {
  titulo: string;
  limpiarHref: string;
  categorias: Categoria[];
  /** Categoría que se está viendo: va resaltada y, plegado, se muestra junto al título. */
  activaId?: string;
}

const { titulo, limpiarHref, categorias, activaId } = Astro.props;
const activa = categorias.find((c) => c.id === activaId);
---

<div class="bz-filtro">
	<input type="checkbox" id="bz-filtro-abierto" class="bz-filtro-estado" />
	<div class="bz-filtro-cabecera">
		<label for="bz-filtro-abierto" class="bz-filtro-titulo">
			{titulo}
			{activa && <span class="bz-filtro-activa">{activa.nombre}</span>}
			<svg class="bz-filtro-flecha" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</label>
		<a href={limpiarHref} class="bz-filtro-limpiar">Limpiar</a>
	</div>

	{categorias.length > 0 && (
		<div class="bz-filtro-cuerpo">
			<div class="bz-filtro-seccion">Categoría</div>
			<div class="bz-filtro-lista">
				{categorias.map((c) => (
					<a href={`/catalogo/${c.slug}`} class:list={['bz-filtro-cat', { 'is-active': c.id === activaId }]}>{c.nombre}</a>
				))}
			</div>
		</div>
	)}
</div>

<style>
	.bz-filtro {
		background: white;
		border-radius: 12px;
		border: 1px solid var(--color-border-soft);
		padding: 20px;
		position: sticky;
		top: 94px;
	}
	/* Oculto pero enfocable: con el teclado se pliega/despliega igual. */
	.bz-filtro-estado {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.bz-filtro-cabecera {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 16px;
	}
	.bz-filtro-titulo {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-text);
	}
	/* La categoría activa y la flecha solo hacen falta plegado (móvil). */
	.bz-filtro-activa,
	.bz-filtro-flecha {
		display: none;
	}
	.bz-filtro-limpiar {
		font-size: 11px;
		font-weight: 500;
		color: var(--color-primary);
		text-decoration: none;
		flex-shrink: 0;
	}
	.bz-filtro-limpiar:hover {
		text-decoration: underline;
	}
	.bz-filtro-seccion {
		font-size: 11px;
		font-weight: 700;
		color: var(--color-text-soft);
		text-transform: uppercase;
		letter-spacing: 0.07em;
		margin-bottom: 10px;
	}
	.bz-filtro-lista {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.bz-filtro-cat {
		display: block;
		padding: 6px 8px;
		border-radius: 7px;
		text-decoration: none;
		font-size: 13px;
		color: var(--color-text-soft);
		transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
	}
	.bz-filtro-cat.is-active {
		background: var(--color-primary-light);
		color: var(--color-primary);
		font-weight: 700;
	}
	/* Realce solo con puntero real: en táctil el :hover queda "pegado" tras el
	   tap. La activa no se desplaza, o el filtro "salta" sobre la que ya estás
	   viendo. */
	@media (hover: hover) {
		.bz-filtro-cat:not(.is-active):hover {
			background: var(--color-primary-light);
			color: var(--color-primary);
			font-weight: 500;
			transform: translateX(1px);
		}
	}

	@media (max-width: 860px) {
		.bz-filtro {
			position: static;
			padding: 12px 16px;
		}
		.bz-filtro-cabecera {
			margin-bottom: 0;
		}
		.bz-filtro-titulo {
			flex: 1;
			cursor: pointer;
			font-size: 14px;
			padding: 4px 0;
		}
		.bz-filtro-activa {
			display: inline-block;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			padding: 3px 10px;
			border-radius: 999px;
			background: var(--color-primary-light);
			color: var(--color-primary);
			font-size: 12px;
			font-weight: 600;
		}
		.bz-filtro-flecha {
			display: block;
			flex-shrink: 0;
			margin-left: auto;
			color: var(--color-text-soft);
			transition: transform 0.2s ease;
		}
		.bz-filtro-estado:checked ~ .bz-filtro-cabecera .bz-filtro-flecha {
			transform: rotate(180deg);
		}
		.bz-filtro-estado:focus-visible ~ .bz-filtro-cabecera .bz-filtro-titulo {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
			border-radius: 6px;
		}
		.bz-filtro-estado:not(:checked) ~ .bz-filtro-cuerpo {
			display: none;
		}
		.bz-filtro-cuerpo {
			margin-top: 12px;
			padding-top: 12px;
			border-top: 1px solid var(--color-surface-muted);
		}
		/* Desplegado, las categorías van como etiquetas en varias columnas:
		   ocupa pocas líneas en vez de una por categoría. */
		.bz-filtro-lista {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 6px;
		}
		.bz-filtro-cat {
			padding: 6px 12px;
			border: 1px solid var(--color-border-soft);
			border-radius: 999px;
		}
		.bz-filtro-cat.is-active {
			border-color: transparent;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.bz-filtro-cat,
		.bz-filtro-flecha {
			transition: none;
		}
	}
</style>
