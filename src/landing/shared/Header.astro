---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { getCategorias } from '@shared/lib/categorias/categoriaService';

// Categorías (instrumentos) tal como están en /admin/categorias, en su mismo
// orden — única fuente de verdad, sin taxonomía alternativa ni agrupador
// intermedio para el nav. Se agregan directo, sin envolverlas bajo un
// bucket tipo "Instrumentos".
const categoriasDb = await getCategorias();
const instrumentLinks = categoriasDb
	.slice()
	.sort((a, b) => a.orden - b.orden)
	.map((cat) => ({ name: cat.nombre, href: `/catalogo/${cat.slug}` }));

const navCats = [...instrumentLinks, { name: 'Accesorios Personalizados', href: '/servicios#servicios' }, { name: 'Trabajos de Ingeniería', href: '/servicios#servicios' }];

const announcement = { text: 'Envío a nivel nacional e internacional', icons: true };
---

<div style="position:sticky; top:0; z-index:200;">
	<!-- ANNOUNCEMENT BAR -->
	<div style="background:var(--color-primary); color:white; padding:9px 32px; font-size:13px; font-weight:500; text-align:center; letter-spacing:0.025em; display:flex; align-items:center; justify-content:center; gap:8px;">
		{announcement.icons && (
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
				<rect x="1" y="3" width="15" height="13" rx="2" stroke="white" stroke-width="1.8" stroke-linejoin="round"></rect>
				<path d="M16 8h3l3 4v5h-6V8z" stroke="white" stroke-width="1.8" stroke-linejoin="round"></path>
				<circle cx="5.5" cy="18.5" r="1.5" stroke="white" stroke-width="1.5"></circle>
				<circle cx="18.5" cy="18.5" r="1.5" stroke="white" stroke-width="1.5"></circle>
			</svg>
		)}
		<span>{announcement.text}</span>
		{announcement.icons && (
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
				<path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" stroke="white" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"></path>
			</svg>
		)}
	</div>

	<!-- HEADER -->
	<header style="background:white; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
		<div class="bz-header-row" style="max-width:1200px; margin:0 auto; padding:0 32px; height:58px; display:flex; align-items:center; gap:6px; border-bottom:1px solid var(--color-surface-muted);">

			<!-- Logo -->
			<a href="/" class="bz-logo-link" style="display:flex; align-items:center; gap:8px; text-decoration:none; flex-shrink:0;">
				<svg width="26" height="26" viewBox="0 0 30 30" fill="none">
					<polygon points="15,1 28,8 28,22 15,29 2,22 2,8" fill="var(--color-primary)"></polygon>
					<polygon points="15,7 22,11 22,19 15,23 8,19 8,11" fill="white" opacity="0.85"></polygon>
					<polygon points="15,11.5 19,14 19,17 15,19.5 11,17 11,14" fill="var(--color-primary)"></polygon>
				</svg>
				<span style="font-size:16px; font-weight:700; color:var(--color-text); letter-spacing:0.01em;">BARZOL</span>
			</a>

			<!-- Categorías (mega menú desktop / drawer mobile) -->
			<div class="cat-trigger" style="position:relative; height:100%; display:flex; align-items:center; flex-shrink:0; margin-left:8px;">
				<button id="cat-trigger-btn" class="bz-cat-btn" type="button" style="display:flex; align-items:center; gap:7px; height:36px; padding:0 11px; font-size:14px; font-weight:600; color:var(--color-primary); background:var(--color-primary-light); border:1px solid var(--color-primary-border); cursor:pointer; border-radius:8px; white-space:nowrap;">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
					<span class="bz-cat-label">Linea de productos</span>
				</button>

				<!-- MEGA PANEL (desktop, hover) -->
				<div class="cat-panel" style="position:absolute; top:100%; left:0; background:white; border:1px solid var(--color-border-soft); border-top:none; box-shadow:0 10px 32px rgba(20,30,50,0.1); border-radius:0 0 10px 10px; overflow:hidden;">
					<div class="cat-sidebar" style="width:222px; padding:10px 0 6px; display:flex; flex-direction:column; gap:1px;">
						{navCats.map((cat) => (
							<a href={cat.href} class="cat-sidebar-item" style="width:100%; display:flex; align-items:center; gap:10px; padding:9px 16px; background:transparent; text-decoration:none; white-space:nowrap; overflow:hidden; box-sizing:border-box;">
								<span style="font-size:13px; font-weight:500; color:var(--color-text-soft); flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{cat.name}</span>
							</a>
						))}
					</div>
				</div>
			</div>

			<!-- Drawer de categorías (mobile) -->
			<div id="cat-drawer-overlay" class="bz-cat-drawer-overlay" hidden style="position:fixed; inset:0; z-index:399; background:rgba(0,0,0,0.45);"></div>
			<div id="cat-drawer-panel" class="bz-cat-drawer-panel" hidden style="position:fixed; left:0; top:0; bottom:0; width:min(320px, 82vw); background:white; z-index:400; display:flex; flex-direction:column; box-shadow:8px 0 32px rgba(0,0,0,0.15);">
				<div style="display:flex; align-items:center; justify-content:flex-end; padding:16px 18px; border-bottom:1px solid var(--color-surface-muted); flex-shrink:0;">
					<button type="button" id="cat-drawer-close" style="display:flex; align-items:center; gap:6px; background:transparent; border:none; cursor:pointer; font-size:15px; font-weight:600; color:var(--color-text);">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="var(--color-text)" stroke-width="2.2" stroke-linecap="round"></path></svg>
						Cerrar
					</button>
				</div>
				<div style="flex:1; overflow-y:auto;">
					{navCats.map((cat) => (
						<a href={cat.href} style="display:block; width:100%; padding:16px 18px; border-bottom:1px solid var(--color-surface-muted); font-size:14.5px; font-weight:600; color:var(--color-text); text-decoration:none; box-sizing:border-box;">{cat.name}</a>
					))}
				</div>
			</div>

			<!-- Buscador -->
			<button id="mobile-search-toggle" class="bz-search-toggle" type="button" style="display:none; align-items:center; justify-content:center; width:36px; height:36px; background:var(--color-bg); border:none; border-radius:8px; cursor:pointer; flex-shrink:0;">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8" stroke="var(--color-text)" stroke-width="2.2"></circle><path d="M21 21l-4.35-4.35" stroke="var(--color-text)" stroke-width="2.2" stroke-linecap="round"></path></svg>
			</button>
			<form action="/busqueda" class="bz-search-wrap" style="position:relative; flex:1 1 300px; max-width:480px; min-width:190px; z-index:300;">
				<input type="text" name="q" placeholder="Buscar productos..." style="width:100%; padding:7px 46px 7px 14px; border:1.5px solid var(--color-border-muted); border-radius:9px; font-size:14px; color:var(--color-text); background:white; outline:none;" />
				<button type="submit" style="position:absolute; right:3px; top:50%; transform:translateY(-50%); width:32px; height:32px; background:transparent; color:var(--color-primary); border:none; border-radius:7px; cursor:pointer; display:flex; align-items:center; justify-content:center;">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none">
						<circle cx="11" cy="11" r="8" stroke="var(--color-primary)" stroke-width="2.2"></circle>
						<path d="M21 21l-4.35-4.35" stroke="var(--color-primary)" stroke-width="2.2" stroke-linecap="round"></path>
					</svg>
				</button>
			</form>

			<!-- Búsqueda a pantalla completa (mobile) -->
			<div id="mobile-search-overlay" class="bz-search-fullscreen" hidden style="position:fixed; inset:0; z-index:400; background:white; display:flex; flex-direction:column;">
				<form action="/busqueda" style="display:flex; align-items:center; gap:10px; padding:14px 16px; border-bottom:1px solid var(--color-surface-muted); flex-shrink:0;">
					<button type="button" id="mobile-search-close" style="display:flex; align-items:center; justify-content:center; width:36px; height:36px; background:transparent; border:none; cursor:pointer; flex-shrink:0;">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="var(--color-text)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</button>
					<input type="text" name="q" placeholder="Buscar productos..." style="flex:1; width:100%; padding:10px 14px; border:1.5px solid var(--color-border-muted); border-radius:9px; font-size:15px; color:var(--color-text); outline:none;" />
				</form>
			</div>

			<div class="bz-header-spacer" style="flex:1; min-width:0;"></div>

			<a href="/nosotros" class="bz-nosotros" style="padding:6px 8px; font-size:14px; font-weight:500; color:var(--color-text-strong); text-decoration:none; border-radius:7px; flex-shrink:0; white-space:nowrap;">Nosotros</a>

			<div class="bz-header-divider" style="width:1px; height:20px; background:var(--color-border); flex-shrink:0; margin:0 2px;"></div>

			<!-- Contacto WhatsApp -->
			<a href="https://wa.me/51950759032" target="_blank" rel="noopener" class="bz-wa-btn" style="display:flex; align-items:center; gap:8px; padding:7px 11px; border-radius:8px; background:transparent; border:1px solid var(--color-border); flex-shrink:0; text-decoration:none; white-space:nowrap;">
				<WhatsAppIcon size={17} fill="var(--color-success)" />
				<span class="bz-wa-text" style="font-size:13px; font-weight:600; color:var(--color-text-strong);">950 759 032</span>
			</a>

		</div>
	</header>
</div>

<style>
	/* Panel flotante de escritorio: se abre con :hover, sin JS. */
	.cat-trigger .cat-panel {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.1s ease;
	}
	.cat-trigger:hover .cat-panel {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}
	.cat-sidebar-item:hover {
		background: var(--color-primary-light) !important;
		color: var(--color-primary) !important;
	}
	.bz-nosotros:hover {
		background: var(--color-bg);
		color: var(--color-primary);
	}
	.bz-wa-btn:hover {
		background: var(--color-bg);
		border-color: var(--color-border-muted);
	}

	/* ===== Responsive ===== */
	@media (max-width: 768px) {
		.bz-header-row {
			flex-wrap: wrap !important;
			height: auto !important;
			padding-top: 10px !important;
			padding-bottom: 10px !important;
			row-gap: 10px !important;
			padding-left: 16px !important;
			padding-right: 16px !important;
			gap: 8px !important;
			position: relative !important;
			width: 100% !important;
			box-sizing: border-box !important;
		}
		.bz-header-row .cat-trigger {
			order: 1 !important;
		}
		.bz-header-row .bz-logo-link {
			position: absolute !important;
			left: 50% !important;
			top: 10px !important;
			transform: translateX(-50%) !important;
		}
		.bz-header-row .bz-header-spacer {
			order: 3 !important;
		}
		.bz-header-row .bz-wa-btn {
			display: none !important;
		}
		.bz-header-row .bz-search-wrap {
			order: 5 !important;
			flex-basis: 100% !important;
			max-width: none !important;
			min-width: 0 !important;
		}
		.bz-header-divider,
		.bz-nosotros {
			display: none !important;
		}
		.bz-cat-label {
			display: none !important;
		}
		.bz-cat-btn {
			padding: 9px !important;
			background: var(--color-bg) !important;
			border: none !important;
		}
		.bz-cat-btn svg {
			width: 20px !important;
			height: 20px !important;
		}
		.bz-search-wrap {
			display: none !important;
		}
		.bz-search-toggle {
			display: flex !important;
			order: 4 !important;
		}
	}
	@media (min-width: 769px) {
		.bz-search-fullscreen,
		#cat-drawer-overlay,
		#cat-drawer-panel {
			display: none !important;
		}
	}
	@media (max-width: 768px) {
		.cat-trigger:hover .cat-panel {
			display: none !important;
		}
	}
</style>

<script>
	function initHeader() {
		const catTriggerBtn = document.getElementById('cat-trigger-btn');
		const drawerOverlay = document.getElementById('cat-drawer-overlay');
		const drawerPanel = document.getElementById('cat-drawer-panel');
		const drawerClose = document.getElementById('cat-drawer-close');

		function openDrawer() {
			drawerOverlay?.removeAttribute('hidden');
			drawerPanel?.removeAttribute('hidden');
		}
		function closeDrawer() {
			drawerOverlay?.setAttribute('hidden', '');
			drawerPanel?.setAttribute('hidden', '');
		}

		catTriggerBtn?.addEventListener('click', () => {
			if (window.matchMedia('(max-width: 768px)').matches) openDrawer();
		});
		drawerOverlay?.addEventListener('click', closeDrawer);
		drawerClose?.addEventListener('click', closeDrawer);

		const mobileSearchToggle = document.getElementById('mobile-search-toggle');
		const mobileSearchOverlay = document.getElementById('mobile-search-overlay');
		const mobileSearchClose = document.getElementById('mobile-search-close');
		mobileSearchToggle?.addEventListener('click', () => mobileSearchOverlay?.removeAttribute('hidden'));
		mobileSearchClose?.addEventListener('click', () => mobileSearchOverlay?.setAttribute('hidden', ''));
	}

	initHeader();
</script>
