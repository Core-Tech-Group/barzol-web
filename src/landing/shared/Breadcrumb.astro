---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<div style="max-width:1200px; margin:0 auto; padding:18px 32px 0;">
	<div style="display:flex; align-items:center; gap:7px; font-size:12px; color:var(--color-text-faint);">
		{items.map((item, i) => (
			<>
				{i > 0 && <span>›</span>}
				{item.href ? (
					<a href={item.href} class="breadcrumb-link" style="color:var(--color-text-muted); text-decoration:none;">{item.label}</a>
				) : (
					<span style="color:var(--color-text); font-weight:500;">{item.label}</span>
				)}
			</>
		))}
	</div>
</div>

<style>
	.breadcrumb-link:hover {
		color: var(--color-primary);
	}
</style>
