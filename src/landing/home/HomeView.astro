---
import { Image } from 'astro:assets';
import PublicLayout from '@landing/layout/PublicLayout.astro';
import ProductCarousel from '@landing/producto/ProductCarousel.astro';
import ServicePromoCard from './ServicePromoCard.astro';
import heroImpresion from '@/assets/hero-impresion-3d.jpg';
import heroDiseno from '@/assets/hero-diseno-cad.jpg';
import heroEscaneo from '@/assets/hero-escaneo-3d.jpg';
// Fotos de las tarjetas de servicios (sin fondo).
import fotoServAccesorios from '@/assets/personalizado-nombre-firma.png';
import fotoServIngenieria from '@/assets/servicio-ingenieria-avanzada.png';
import fotoServEscaneo from '@/assets/servicio-escaneo-impresion-3d.png';
import { getHomeItems } from '@shared/lib/home/homeService';
import { getProductosByIds } from '@shared/lib/productos/productoService';
import { productoUrl } from '@shared/lib/productos/productoUrl';

// Adaptador: las secciones de productos del home (administradas en
// /admin/inicio) referencian productos por id; acá se resuelven a la forma
// que espera ProductCarousel (href/nombre/precio). Los banners de imagen no
// se renderizan todavía en esta vista — el hero actual es estático, sin
// slots de imagen — así que solo se muestran las secciones de tipo 'seccion'.
const homeItemsDb = await getHomeItems();
const visibleSections = homeItemsDb.filter((it) => it.tipo === 'seccion' && it.visible);

// Solo se piden los productos que las secciones visibles realmente
// referencian — no toda la tabla product (a diferencia de getProductos()).
const neededProductIds = [...new Set(visibleSections.flatMap((it) => it.productoIds))];
const productosDb = await getProductosByIds(neededProductIds);

const productById = new Map(productosDb.map((p) => [p.id, p]));

const sections = visibleSections
  .sort((a, b) => a.orden - b.orden)
  .map((it) => {
    const productos = it.productoIds.map((pid) => productById.get(pid)).filter((p): p is NonNullable<typeof p> => !!p);
    return {
      title: it.titulo ?? '',
      products: productos.map((p) => ({ href: productoUrl(p), nombre: p.nombre, precio: p.precio, precioOriginal: p.precioOriginal ?? undefined, foto: p.fotos[0] })),
    };
  })
  .filter((s) => s.products.length > 0);

// Fotos del slider del hero, en orden. Viven en el repo (no en R2): son parte
// del diseño y así Astro las optimiza. `posicion` es el object-position de
// cada una — el sujeto (producto o persona) está a la derecha en las tres, y
// es lo que tiene que sobrevivir al recorte de `cover`.
const heroSlides = [
  { src: heroImpresion, alt: 'Ingeniero de Barzol supervisando la impresión 3D de una sordina', posicion: '78% center' },
  { src: heroDiseno, alt: 'Ingeniero de Barzol diseñando en CAD un soporte para celular', posicion: '72% center' },
  { src: heroEscaneo, alt: 'Ingeniero de Barzol escaneando en 3D una pieza metálica', posicion: '75% center' },
];
---

<PublicLayout title="Barzol — Accesorios musicales impresos en 3D">
	<!-- HERO BANNER -->
	<section class="bz-hero" data-hero-slider aria-roledescription="carrusel" aria-label="Destacados" style="position:relative; height:560px; overflow:hidden; background:#0f1e46;">
		{/* Diseño dividido: el texto va siempre sobre azul sólido y las fotos
		    ocupan la derecha, fundidas hacia el azul. Así da igual si una foto
		    tiene fondo claro u oscuro — el texto se lee igual en todos los
		    slides, y el slider solo cambia la foto.

		    `widths`/`sizes` hacen que Astro emita versiones WebP por ancho. La
		    primera es el LCP de la home: `fetchpriority=high`. Las demás
		    también son `eager` —con `lazy` el navegador las posterga porque
		    están invisibles (opacity 0) y el cruce mostraba el azul vacío—,
		    pero con prioridad baja para no competir con la primera. */}
		<div class="bz-hero-media">
			{heroSlides.map((slide, i) => (
				<Image
					src={slide.src}
					alt={slide.alt}
					widths={[768, 1280, 1920]}
					sizes="(max-width: 768px) 100vw, 62vw"
					loading="eager"
					fetchpriority={i === 0 ? 'high' : 'low'}
					class:list={['bz-hero-slide', { 'is-active': i === 0 }]}
					style={`object-position:${slide.posicion};`}
					aria-hidden={i === 0 ? 'false' : 'true'}
					data-hero-slide
				/>
			))}
			<div class="bz-hero-fade"></div>
		</div>
		<div class="bz-hero-text" style="position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; padding:20px 72px 0; z-index:10; max-width:720px;">
			<div style="font-size:10px; font-weight:700; letter-spacing:0.16em; color:rgba(255,255,255,0.75); text-transform:uppercase; margin-bottom:14px; animation:fadeSlide 0.6s ease both; animation-delay:0.1s;">Barzol, Perú</div>
			<h1 class="bz-hero-title" style="font-size:44px; font-weight:700; color:white; line-height:1.12; margin-bottom:16px; animation:fadeSlide 0.7s ease both; animation-delay:0.3s;">Accesorios exclusivos,<br /><span style="color:var(--color-primary-soft);">diseñados para tu instrumento musical</span></h1>
			<p class="bz-hero-desc" style="font-size:15px; color:rgba(255,255,255,0.82); margin-bottom:24px; line-height:1.7; max-width:440px; animation:fadeSlide 0.7s ease both; animation-delay:0.55s;">Diseñados con ingeniería y fabricados con tecnología 3D, para músicos de bandas y orquestas.</p>
			<p class="bz-hero-badges" style="font-size:12.5px; font-weight:500; color:rgba(255,255,255,0.75); margin-bottom:32px; animation:fadeSlide 0.7s ease both; animation-delay:0.7s;">· Diseño propio &nbsp; · Ingeniería aplicada &nbsp; · Envíos nacionales e internacionales</p>
			<div class="bz-hero-cta" style="display:flex; gap:12px; align-items:center; animation:fadeSlide 0.7s ease both; animation-delay:0.8s;">
				<a href="/busqueda" class="hero-cta-primary" style="display:inline-flex; align-items:center; gap:8px; padding:13px 26px; background:var(--color-primary); color:white; font-size:14px; font-weight:600; text-decoration:none; border-radius:9px; box-shadow:0 6px 20px rgba(var(--color-primary-rgb),0.4);">
					Ver Productos
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
				<a href="#servicios" class="hero-cta-secondary" data-scroll-suave style="display:inline-flex; align-items:center; gap:8px; padding:13px 22px; background:rgba(255,255,255,0.15); color:white; font-size:14px; font-weight:500; text-decoration:none; border-radius:9px; border:1px solid rgba(255,255,255,0.3);">Servicios <span class="bz-cta-arrow" aria-hidden="true">→</span></a>
			</div>
		</div>
		{heroSlides.length > 1 && (
			<div class="bz-hero-dots">
				{heroSlides.map((_, i) => (
					<button type="button" class:list={['bz-hero-dot', { 'is-active': i === 0 }]} data-hero-dot aria-label={`Ver foto ${i + 1} de ${heroSlides.length}`} aria-current={i === 0 ? 'true' : 'false'}></button>
				))}
			</div>
		)}
	</section>

	<!-- PRODUCT SECTIONS -->
	<div class="bz-section-wrap" style="max-width:1200px; margin:0 auto; padding:0 32px;">
		{sections.map((section, i) => (
			<div style={i === 0 ? 'margin-top:48px;' : undefined}>
				<ProductCarousel title={section.title} products={section.products} />
			</div>
		))}
	</div>

	<!-- SERVICES — destino del botón "Servicios →" del hero -->
	<div id="servicios" class="bz-services-anchor bz-section-wrap" style="max-width:1200px; margin:52px auto 0; padding:0 32px;">
		<div class="bz-services-grid" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
			{/* Un tono claro de la paleta por servicio: celeste de marca, gris
			    azulado y azul cielo (familia de --color-primary-soft).
			    Los títulos van en dos líneas cortas a propósito: en una sola, el
			    texto pasa por encima de la foto de la derecha. */}
			<ServicePromoCard
				title="Accesorios<br />personalizados"
				href="/servicios/accesorios-personalizados"
				fondo="linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-border) 100%)"
				arco="#c3d7f7"
				acento="var(--color-primary)"
				imagen={fotoServAccesorios}
			/>
			<ServicePromoCard
				title="Trabajos de<br />ingeniería <br class='bz-sc-br-movil' />avanzada"
				href="/servicios/trabajos-de-ingenieria-avanzada"
				fondo="linear-gradient(135deg, #f5f7fa 0%, #e1e6ee 100%)"
				arco="#cfd7e3"
				acento="#334155"
				imagen={fotoServIngenieria}
				escala={1.1}
			/>
			<ServicePromoCard
				title="Escaneo e<br />impresión 3D"
				href="/servicios/escaneo-impresion-3d"
				fondo="linear-gradient(135deg, #eaf4ff 0%, #c7e0fd 100%)"
				arco="#a9cdf8"
				acento="#1d5fa8"
				imagen={fotoServEscaneo}
				escala={1.32}
				giro={0}
				origen="top right"
				correrX={14}
			/>
		</div>
	</div>
</PublicLayout>

<style>
	/* Zona de fotos: la derecha del hero. El texto queda sobre el azul sólido
	   del contenedor. */
	.bz-hero-media {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 62%;
	}
	/* Las fotos se apilan y se cruzan por opacidad: no hay desplazamiento, así
	   que no hay salto de layout ni parpadeo del texto. */
	.bz-hero-slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.9s ease;
	}
	.bz-hero-slide.is-active {
		opacity: 1;
	}
	/* Funde el borde izquierdo de la foto con el azul del panel de texto. Es
	   lo que hace que una foto de fondo blanco no se vea como un rectángulo
	   pegado. */
	.bz-hero-fade {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 45%;
		background: linear-gradient(90deg, #0f1e46 0%, rgba(15, 30, 70, 0.75) 35%, rgba(15, 30, 70, 0) 100%);
		pointer-events: none;
	}

	.bz-hero-dots {
		position: absolute;
		/* 71 + 1px de margen interno de la píldora = 72px, el mismo borde
		   izquierdo que el texto. */
		left: 71px;
		bottom: 20px;
		z-index: 11;
		display: flex;
	}
	/* El botón mide 24×24 —el mínimo cómodo para tocar con el dedo— y el
	   punto visible (8px, o la píldora de 24px del activo) se dibuja adentro
	   con ::before. */
	.bz-hero-dot {
		width: 24px;
		height: 24px;
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.bz-hero-dot::before {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 99px;
		background: rgba(255, 255, 255, 0.4);
		transition: width 0.3s ease, background-color 0.3s ease;
	}
	.bz-hero-dot:hover::before {
		background: rgba(255, 255, 255, 0.7);
	}
	.bz-hero-dot.is-active::before {
		width: 22px;
		background: white;
	}
	.bz-hero-dot:focus-visible {
		outline: 2px solid var(--color-primary-soft);
		outline-offset: 1px;
		border-radius: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		.bz-hero-slide,
		.bz-hero-dot::before {
			transition: none;
		}
	}

	/* Pantallas medianas: la foto cede un poco de ancho para que el título no
	   se meta en la parte clara. */
	@media (max-width: 1100px) and (min-width: 769px) {
		.bz-hero-media {
			width: 55%;
		}
		.bz-hero-title {
			font-size: 36px !important;
		}
	}

	/* El header es sticky (~96px): sin este margen, al saltar al ancla la
	   sección queda escondida debajo de él. */
	.bz-services-anchor {
		scroll-margin-top: 120px;
	}

	/* Botones del hero. Los colores base están inline en el HTML, así que el
	   hover necesita !important para ganarles — sin eso, estas reglas
	   existían pero nunca se aplicaban. */
	.hero-cta-primary,
	.hero-cta-secondary {
		transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.hero-cta-primary svg,
	.bz-cta-arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}
	/* Solo con puntero real: en pantallas táctiles el hover queda "pegado"
	   después del toque. */
	@media (hover: hover) {
		.hero-cta-primary:hover {
			background: var(--color-primary-dark) !important;
			box-shadow: 0 10px 26px rgba(var(--color-primary-rgb), 0.55) !important;
			transform: translateY(-1px);
		}
		.hero-cta-secondary:hover {
			background: rgba(255, 255, 255, 0.24) !important;
			border-color: rgba(255, 255, 255, 0.55) !important;
			transform: translateY(-1px);
		}
		.hero-cta-primary:hover svg,
		.hero-cta-secondary:hover .bz-cta-arrow {
			transform: translateX(2px);
		}
	}
	/* Al presionar vuelve a su lugar: da sensación de clic. */
	.hero-cta-primary:active,
	.hero-cta-secondary:active {
		transform: translateY(0);
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-cta-primary,
		.hero-cta-secondary,
		.hero-cta-primary svg,
		.bz-cta-arrow {
			transition: none;
		}
		.hero-cta-primary:hover,
		.hero-cta-secondary:hover,
		.hero-cta-primary:hover svg,
		.hero-cta-secondary:hover .bz-cta-arrow {
			transform: none;
		}
	}

	@media (max-width: 768px) {
		.bz-hero {
			height: 420px !important;
		}
		/* En pantalla angosta no entran dos columnas: la foto pasa a ocupar
		   todo el fondo, detrás del texto, y el fundido lateral se convierte
		   en un velo vertical que garantiza el contraste del texto blanco. */
		.bz-hero-media {
			width: 100%;
		}
		.bz-hero-fade {
			width: 100%;
			background: linear-gradient(180deg, rgba(15, 30, 70, 0.9) 0%, rgba(15, 30, 70, 0.8) 55%, rgba(15, 30, 70, 0.6) 100%);
		}
		.bz-hero-dots {
			left: 19px;
			bottom: 10px;
		}
		.bz-hero-text {
			padding: 20px 20px 0 !important;
			max-width: 100% !important;
		}
		.bz-hero-title {
			font-size: 28px !important;
			margin-bottom: 10px !important;
		}
		.bz-hero-desc {
			font-size: 13px !important;
			margin-bottom: 16px !important;
		}
		.bz-hero-badges {
			display: none !important;
		}
		.bz-hero-cta a {
			padding: 10px 16px !important;
			font-size: 13px !important;
		}
		.bz-services-grid {
			grid-template-columns: 1fr !important;
		}
	}
	@media (max-width: 480px) {
		.bz-hero {
			height: 380px !important;
		}
	}
</style>

<script>
	const INTERVALO_MS = 6000;

	function initHeroSlider() {
		document.querySelectorAll<HTMLElement>('[data-hero-slider]').forEach((raiz) => {
			if (raiz.dataset.wired) return;
			raiz.dataset.wired = 'true';

			const slides = [...raiz.querySelectorAll<HTMLElement>('[data-hero-slide]')];
			const dots = [...raiz.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
			if (slides.length < 2) return;

			let actual = 0;
			let timer: number | undefined;

			const ir = (n: number) => {
				actual = (n + slides.length) % slides.length;
				slides.forEach((s, i) => {
					s.classList.toggle('is-active', i === actual);
					s.setAttribute('aria-hidden', i === actual ? 'false' : 'true');
				});
				dots.forEach((d, i) => {
					d.classList.toggle('is-active', i === actual);
					d.setAttribute('aria-current', i === actual ? 'true' : 'false');
				});
			};

			const detener = () => {
				if (timer !== undefined) window.clearInterval(timer);
				timer = undefined;
			};
			// Con movimiento reducido no hay avance automático: solo los puntos.
			const arrancar = () => {
				detener();
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				timer = window.setInterval(() => ir(actual + 1), INTERVALO_MS);
			};

			// Elegir una foto reinicia la cuenta, para que no salte enseguida.
			dots.forEach((d, i) =>
				d.addEventListener('click', () => {
					ir(i);
					arrancar();
				})
			);
			// Se pausa mientras el mouse está encima (desktop): nadie quiere que
			// la foto cambie mientras la está mirando.
			raiz.addEventListener('mouseenter', detener);
			raiz.addEventListener('mouseleave', arrancar);

			// El intervalo vive en `window`, no en el DOM: si no se corta al
			// navegar con ClientRouter, seguiría corriendo sobre nodos ya
			// descartados y se sumaría uno nuevo en cada visita a la home.
			document.addEventListener('astro:before-swap', detener, { once: true });

			arrancar();
		});
	}

	document.addEventListener('astro:page-load', initHeroSlider);
	initHeroSlider();

	// "Servicios →" del hero: el href="#servicios" ya funciona sin JS (salto
	// directo); esto solo lo convierte en un desplazamiento suave, salvo que el
	// sistema pida reducir movimiento. El listener va sobre el propio enlace,
	// que se reemplaza en cada navegación, así que no se acumula.
	function initScrollSuave() {
		document.querySelectorAll<HTMLAnchorElement>('a[data-scroll-suave]').forEach((enlace) => {
			if (enlace.dataset.wired) return;
			enlace.dataset.wired = 'true';
			enlace.addEventListener('click', (e) => {
				const destino = document.querySelector(enlace.getAttribute('href') ?? '');
				if (!destino) return;
				e.preventDefault();
				const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				destino.scrollIntoView({ behavior: reducido ? 'auto' : 'smooth', block: 'start' });
			});
		});
	}

	document.addEventListener('astro:page-load', initScrollSuave);
	initScrollSuave();
</script>
