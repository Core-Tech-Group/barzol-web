---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import ProductCarousel from '@landing/producto/ProductCarousel.astro';
import ServicePromoCard from './ServicePromoCard.astro';
import { getHomeItems } from '@shared/lib/home/homeService';
import { getProductos } from '@shared/lib/productos/productoService';
import { getCategorias } from '@shared/lib/categorias/categoriaService';
import { productoUrl } from '@shared/lib/productos/productoUrl';

// Adaptador: las secciones de productos del home (administradas en
// /admin/inicio) referencian productos por id; acá se resuelven a la forma
// que espera ProductCarousel (href/nombre/precio). Los banners de imagen no
// se renderizan todavía en esta vista — el hero actual es estático, sin
// slots de imagen — así que solo se muestran las secciones de tipo 'seccion'.
const [homeItemsDb, productosDb, categoriasDb] = await Promise.all([getHomeItems(), getProductos(), getCategorias()]);

const productById = new Map(productosDb.map((p) => [p.id, p]));
const categoryById = new Map(categoriasDb.map((c) => [c.id, c]));

const sections = homeItemsDb
  .filter((it) => it.tipo === 'seccion' && it.visible)
  .sort((a, b) => a.orden - b.orden)
  .map((it) => {
    const productos = it.productoIds.map((pid) => productById.get(pid)).filter((p): p is NonNullable<typeof p> => !!p);
    // "Ver todo" solo tiene sentido si TODOS los productos de la sección son
    // del mismo instrumento (categoría) — si la sección mezcla instrumentos
    // (ej. "Soportes para celular" con productos de Trompeta, Clarinete...)
    // no hay una única página de categoría a la que enlazar.
    const categoriaIds = new Set(productos.map((p) => p.categoriaId));
    const singleCategoria = categoriaIds.size === 1 ? categoryById.get([...categoriaIds][0] ?? '') : undefined;
    return {
      title: it.titulo ?? '',
      viewAllHref: singleCategoria ? `/catalogo/${singleCategoria.slug}` : undefined,
      products: productos.map((p) => ({ href: productoUrl(p), nombre: p.nombre, precio: p.precio, precioOriginal: p.precioOriginal ?? undefined })),
    };
  })
  .filter((s) => s.products.length > 0);
---

<PublicLayout title="Barzol — Accesorios musicales impresos en 3D">
	<!-- HERO BANNER -->
	<div class="bz-hero" style="position:relative; height:560px; overflow:hidden; background:linear-gradient(120deg,#0f1e46 0%,var(--color-primary) 100%);">
		<div class="bz-hero-text" style="position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; padding:20px 72px 0; z-index:10; max-width:720px;">
			<div style="font-size:10px; font-weight:700; letter-spacing:0.16em; color:rgba(255,255,255,0.75); text-transform:uppercase; margin-bottom:14px; animation:fadeSlide 0.6s ease both; animation-delay:0.1s;">Barzol, Perú</div>
			<h1 class="bz-hero-title" style="font-size:44px; font-weight:700; color:white; line-height:1.12; margin-bottom:16px; animation:fadeSlide 0.7s ease both; animation-delay:0.3s;">Accesorios exclusivos,<br /><span style="color:var(--color-primary-soft);">diseñados para tu instrumento</span></h1>
			<p class="bz-hero-desc" style="font-size:15px; color:rgba(255,255,255,0.82); margin-bottom:24px; line-height:1.7; max-width:420px; animation:fadeSlide 0.7s ease both; animation-delay:0.55s;">Diseñados con Ingeniería Inversa e Impresión 3D. Usados por bandas y orquestas en todo el Perú.</p>
			<p class="bz-hero-badges" style="font-size:12.5px; font-weight:500; color:rgba(255,255,255,0.75); margin-bottom:32px; animation:fadeSlide 0.7s ease both; animation-delay:0.7s;">Diseño exclusivo · Productos patentados · Envío nacional e internacional</p>
			<div class="bz-hero-cta" style="display:flex; gap:12px; align-items:center; animation:fadeSlide 0.7s ease both; animation-delay:0.8s;">
				<a href="/busqueda" class="hero-cta-primary" style="display:inline-flex; align-items:center; gap:8px; padding:13px 26px; background:var(--color-primary); color:white; font-size:14px; font-weight:600; text-decoration:none; border-radius:9px; box-shadow:0 6px 20px rgba(var(--color-primary-rgb),0.4);">
					Ver Productos
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
				<a href="/servicios" class="hero-cta-secondary" style="display:inline-flex; align-items:center; gap:8px; padding:13px 22px; background:rgba(255,255,255,0.15); color:white; font-size:14px; font-weight:500; text-decoration:none; border-radius:9px; border:1px solid rgba(255,255,255,0.3);">Servicios →</a>
			</div>
		</div>
	</div>

	<!-- PRODUCT SECTIONS -->
	<div class="bz-section-wrap" style="max-width:1200px; margin:0 auto; padding:0 32px;">
		{sections.map((section, i) => (
			<div style={i === 0 ? 'margin-top:48px;' : undefined}>
				<ProductCarousel title={section.title} viewAllHref={section.viewAllHref} products={section.products} />
			</div>
		))}
	</div>

	<!-- SERVICES -->
	<div style="max-width:1200px; margin:52px auto 0; padding:0 32px;">
		<div class="bz-services-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
			<ServicePromoCard
				title="Accesorios personalizados"
				href="/servicios#servicios"
				gradient="linear-gradient(135deg,#0d3b8c 0%,var(--color-primary) 60%,#2979ff 100%)"
			/>
			<ServicePromoCard
				title="Trabajos de ingeniería"
				href="/servicios#servicios"
				gradient="linear-gradient(135deg,#7c2d12 0%,var(--color-orange) 55%,#f97316 100%)"
			/>
		</div>
	</div>
</PublicLayout>

<style>
	.hero-cta-primary:hover {
		background: var(--color-primary-dark);
	}
	.hero-cta-secondary:hover {
		background: rgba(255, 255, 255, 0.25);
	}

	@media (max-width: 768px) {
		.bz-hero {
			height: 420px !important;
		}
		.bz-hero-text {
			padding: 20px 20px 0 !important;
			max-width: 100% !important;
		}
		.bz-hero-title {
			font-size: 28px !important;
			margin-bottom: 10px !important;
		}
		.bz-hero-desc {
			font-size: 13px !important;
			margin-bottom: 16px !important;
		}
		.bz-hero-badges {
			display: none !important;
		}
		.bz-hero-cta a {
			padding: 10px 16px !important;
			font-size: 13px !important;
		}
		.bz-services-grid {
			grid-template-columns: 1fr !important;
		}
	}
	@media (max-width: 480px) {
		.bz-hero {
			height: 380px !important;
		}
	}
</style>
