---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Tarjeta de servicio del home: fondo claro con el tono propio del servicio,
// un arco de color detrás de la foto y el texto en azul oscuro.
interface Props {
  title: string;
  href: string;
  /** Fondo de la tarjeta (degradado claro de la paleta). */
  fondo: string;
  /** Color del arco detrás de la foto. */
  arco: string;
  /** Color de la etiqueta "Servicios" y del botón. */
  acento: string;
  /** Foto sin fondo. Es decorativa: el nombre del servicio ya lo dice el título. */
  imagen: ImageMetadata;
  /** Agranda la foto dentro de su caja, para piezas delgadas que con el
   *  mismo tamaño que las demás se ven chicas. Por defecto 1. */
  escala?: number;
  /** Giro de la foto en grados. Por defecto -8; 0 para fotos que ya vienen
   *  compuestas y se ven mejor derechas. */
  giro?: number;
  /** Punto desde el que crece la foto al escalarla (transform-origin). Por
   *  defecto el centro; 'top right' para fotos altas, que desde el centro
   *  se saldrían por arriba de la tarjeta. */
  origen?: string;
  /** Corre la foto a la derecha, en px (negativo: a la izquierda). Por defecto 0. */
  correrX?: number;
}

const { title, href, fondo, arco, acento, imagen, escala = 1, giro = -8, origen = 'center', correrX = 0 } = Astro.props;
---

<a href={href} class="bz-service-card" style={`--fondo:${fondo}; --arco:${arco}; --acento:${acento}; --escala:${escala}; --giro:${giro}deg; --origen:${origen}; --correr-x:${correrX}px;`}>
	<div class="bz-sc-arco" aria-hidden="true"></div>
	{/* Caja de tamaño fijo: las tres fotos quedan en la misma posición, sin
	    importar la proporción de cada imagen. */}
	<div class="bz-sc-foto">
		<Image src={imagen} alt="" widths={[200, 400]} sizes="190px" />
	</div>
	<div class="bz-sc-cuerpo">
		<div class="bz-sc-etiqueta">Servicios</div>
		<h3 class="bz-service-card-title" set:html={title} />
		<span class="bz-sc-boton">Ver más <span class="bz-sc-flecha" aria-hidden="true">→</span></span>
	</div>
</a>

<style>
	.bz-service-card {
		position: relative;
		display: block;
		height: 288px;
		border-radius: 14px;
		overflow: hidden;
		text-decoration: none;
		background: var(--fondo);
		border: 1px solid rgba(var(--color-primary-rgb), 0.08);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	/* Arco que se desvanece hacia abajo, detrás de la foto. */
	.bz-sc-arco {
		position: absolute;
		top: 24px;
		right: 20px;
		bottom: 0;
		width: 44%;
		border-radius: 999px 999px 0 0;
		background: linear-gradient(180deg, var(--arco), rgba(255, 255, 255, 0));
	}
	.bz-sc-foto {
		position: absolute;
		z-index: 2;
		top: 12px;
		right: 16px;
		width: 46%;
		height: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transform: translateX(var(--correr-x)) rotate(var(--giro));
		transition: transform 0.25s ease;
	}
	.bz-sc-foto :global(img) {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		transform: scale(var(--escala));
		transform-origin: var(--origen);
		filter: drop-shadow(0 14px 16px rgba(15, 30, 70, 0.24));
	}
	.bz-sc-cuerpo {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 26px 28px 28px;
	}
	.bz-sc-etiqueta {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--acento);
		opacity: 0.75;
		margin-bottom: 8px;
	}
	.bz-service-card-title {
		font-size: clamp(20px, 2vw, 24px);
		font-weight: 700;
		color: var(--color-navy-dark, #0f1e46);
		line-height: 1.12;
		margin-bottom: 20px;
	}
	/* Salto de línea que solo aplica en móvil, para títulos que ahí pasarían
	   por encima de la foto. */
	.bz-service-card-title :global(.bz-sc-br-movil) {
		display: none;
	}
	.bz-sc-boton {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		align-self: flex-start;
		padding: 10px 18px;
		background: var(--acento);
		color: white;
		font-size: 12px;
		font-weight: 600;
		border-radius: 8px;
	}
	.bz-sc-flecha {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	/* Solo con puntero real: en táctil el hover queda "pegado". */
	@media (hover: hover) {
		.bz-service-card:hover {
			transform: translateY(-3px);
			box-shadow: 0 14px 30px rgba(15, 30, 70, 0.12);
		}
	
		.bz-service-card:hover .bz-sc-flecha {
			transform: translateX(3px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.bz-service-card,
		.bz-sc-foto,
		.bz-sc-flecha {
			transition: none;
		}
	}

	@media (max-width: 768px) {
		.bz-service-card {
			height: 220px;
		}
		/* En móvil la grilla pasa a una columna: la tarjeta vuelve a ser
		   ancha y el título no necesita achicarse con el viewport. */
		.bz-service-card-title {
			font-size: 22px;
		}
		.bz-service-card-title :global(.bz-sc-br-movil) {
			display: inline;
		}
		.bz-sc-foto {
			width: 40%;
			height: 62%;
		}
		/* La caja ya es proporcionalmente más grande en móvil: la mitad del
		   aumento basta y evita que la foto toque el título. */
		.bz-sc-foto :global(img) {
			transform: scale(calc(1 + (var(--escala) - 1) / 2));
		}
		.bz-sc-arco {
			width: 40%;
			top: 26px;
		}
	}
</style>
