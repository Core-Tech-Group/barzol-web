---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import Breadcrumb from '@landing/shared/Breadcrumb.astro';
import ProductCard from '@landing/producto/ProductCard.astro';
import SortSelect from '@landing/shared/SortSelect.astro';
import FiltroCategorias from '@landing/shared/FiltroCategorias.astro';
import Pagination from '@landing/busqueda/Pagination.astro';
import { ordenarProductos, parseOrden, ORDEN_POR_DEFECTO } from '@landing/shared/ordenProductos';
import { getProductosByCategoria, getProductosPublicados } from '@shared/lib/productos/productoService';
import { getCategorias } from '@shared/lib/categorias/categoriaService';
import { productoUrl } from '@shared/lib/productos/productoUrl';

interface Props {
  categoria?: string;
}

const { categoria = '' } = Astro.props;

// `categoria` es el slug del INSTRUMENTO — la misma categoría que se
// administra en /admin/categorias, sin taxonomía alternativa. Viene vacío en
// `/catalogo`, que es el catálogo entero sin filtrar (destino de "Limpiar").
const categoriasDb = await getCategorias();
const categoriaActual = categoriasDb.find((c) => c.slug === categoria);
const sinFiltro = !categoriaActual;
const categoryName = categoriaActual?.nombre ?? 'Catálogo';

// Solo se pide a la base de datos lo que esta página muestra: sin filtro, los
// publicados y activos; con filtro, los de ESTE instrumento (su propio id +
// el de cada subcategoría — product.category_id siempre apunta a una hoja,
// nunca al instrumento). En ningún caso la tabla product completa.
const leafIds = categoriaActual ? [categoriaActual.id, ...categoriaActual.subcategorias.map((s) => s.id)] : [];
const matched = sinFiltro ? await getProductosPublicados() : await getProductosByCategoria(leafIds);

// El orden se aplica ANTES de paginar: si no, cada página se ordenaría por
// separado y el listado completo quedaría desordenado.
const orden = parseOrden(Astro.url.searchParams.get('orden'));
const ordenados = ordenarProductos(matched, orden);

const PAGE_SIZE = 12;
const totalPages = Math.max(1, Math.ceil(ordenados.length / PAGE_SIZE));
const requestedPage = Number(Astro.url.searchParams.get('page')) || 1;
const currentPage = Math.min(Math.max(requestedPage, 1), totalPages);
const pageItems = ordenados.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

const products = pageItems.map((p) => ({ id: p.id, href: productoUrl(p), nombre: p.nombre, precio: p.precio, precioOriginal: p.precioOriginal ?? undefined, foto: p.fotos[0] }));

// "Limpiar" quita el filtro de categoría y deja el catálogo completo — la
// misma vista, sin filtrar. Conserva el orden: es una preferencia de
// visualización, no un filtro.
const limpiarHref = orden === ORDEN_POR_DEFECTO ? '/catalogo' : `/catalogo?orden=${orden}`;

// Sin filtro no hay nivel que mostrar después de "Inicio": el breadcrumb
// termina ahí en vez de repetir un rótulo genérico.
const breadcrumbItems = sinFiltro
  ? [{ label: 'Inicio', href: '/' }]
  : [{ label: 'Inicio', href: '/' }, { label: categoryName }];
---

<PublicLayout title={`${categoryName} — Barzol`}>
	<Breadcrumb items={breadcrumbItems} />

	<!-- CATEGORY HERO -->
	<!--div class="bz-section-wrap" style="max-width:1200px; margin:0 auto; padding:20px 32px 0;">
		<div class="bz-cat-hero" style="position:relative; height:220px; background:linear-gradient(130deg,#e8edf8 0%,#dde4f2 60%,#d0daea 100%); border-radius:16px; overflow:hidden; display:flex; align-items:center;">
			<div class="bz-cat-hero-text" style="position:relative; z-index:2; padding:0 48px; max-width:480px;">
				<div style="font-size:10px; font-weight:700; letter-spacing:0.14em; color:var(--color-primary); text-transform:uppercase; margin-bottom:8px;">Categoría</div>
				<h1 style="font-size:32px; font-weight:700; color:var(--color-text); line-height:1.15; margin-bottom:10px;">{categoryName}</h1>
				<p style="font-size:13.5px; color:var(--color-text-muted); line-height:1.6;">Monta tu celular en cualquier instrumento. Diseñados con impresión 3D.</p>
			</div>
		</div>
	</div>


	<!-- MAIN CONTENT -->
	<div class="bz-section-wrap bz-cat-main" style="max-width:1200px; margin:0 auto; padding:20px 0px 64px; display:grid; grid-template-columns:200px 1fr; gap:24px; align-items:start;">

		<!-- SIDEBAR -->
		<FiltroCategorias titulo="Filtro" limpiarHref={limpiarHref} categorias={categoriasDb} activaId={categoriaActual?.id} />

		<!-- PRODUCT GRID -->
		<div>
			<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
				<span style="font-size:13px; color:var(--color-text-muted);"><span style="font-weight:600; color:var(--color-text);">{matched.length}</span> productos</span>
				<div style="display:flex; align-items:center; gap:9px;">
					<span style="font-size:13px; color:var(--color-text-muted);">Ordenar por</span>
					<SortSelect orden={orden} />
				</div>
			</div>
			<div class="bz-cat-product-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:14px;">
				{products.map((p) => (
					<ProductCard href={p.href} nombre={p.nombre} precio={p.precio} precioOriginal={p.precioOriginal} foto={p.foto} />
				))}
			</div>

			<Pagination currentPage={currentPage} totalPages={totalPages} basePath={sinFiltro ? '/catalogo' : `/catalogo/${categoria}`} extraParams={{ orden }} />
		</div>

	</div>
</PublicLayout>

<style>
	@media (max-width: 860px) {
		.bz-cat-hero {
			height: auto !important;
			min-height: 200px !important;
			flex-direction: column !important;
			align-items: flex-start !important;
			padding: 24px 0 !important;
		}
		.bz-cat-hero-text {
			padding: 0 20px !important;
			max-width: 100% !important;
		}
		.bz-cat-main {
			grid-template-columns: 1fr !important;
		}
		.bz-cat-product-grid {
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)) !important;
		}
	}
	@media (max-width: 420px) {
		.bz-cat-product-grid {
			gap: 10px !important;
		}
	}
</style>
