---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import Breadcrumb from '@landing/shared/Breadcrumb.astro';
import ProductCard from '@landing/producto/ProductCard.astro';
import Pagination from '@landing/busqueda/Pagination.astro';
import { getProductosByCategoria } from '@shared/lib/productos/productoService';
import { getCategorias } from '@shared/lib/categorias/categoriaService';
import { productoUrl } from '@shared/lib/productos/productoUrl';

interface Props {
  categoria?: string;
}

const { categoria = '' } = Astro.props;

// `categoria` es el slug del INSTRUMENTO — la misma categoría que se
// administra en /admin/categorias, sin taxonomía alternativa.
const categoriasDb = await getCategorias();
const categoriaActual = categoriasDb.find((c) => c.slug === categoria);
const categoryName = categoriaActual?.nombre ?? 'Categoría';

// Solo se pide a la base de datos lo que esta página muestra: los productos
// de ESTE instrumento (su propio id + el de cada subcategoría — product.category_id
// siempre apunta a una hoja, nunca al instrumento), publicados y activos —
// no la tabla product completa.
const leafIds = categoriaActual ? [categoriaActual.id, ...categoriaActual.subcategorias.map((s) => s.id)] : [];
const matched = await getProductosByCategoria(leafIds);

const PAGE_SIZE = 12;
const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
const requestedPage = Number(Astro.url.searchParams.get('page')) || 1;
const currentPage = Math.min(Math.max(requestedPage, 1), totalPages);
const pageItems = matched.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

const products = pageItems.map((p) => ({ id: p.id, href: productoUrl(p), nombre: p.nombre, precio: p.precio, precioOriginal: p.precioOriginal ?? undefined }));
---

<PublicLayout title={`${categoryName} — Barzol`}>
	<Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: categoryName }]} />

	<!-- CATEGORY HERO -->
	<!--div class="bz-section-wrap" style="max-width:1200px; margin:0 auto; padding:20px 32px 0;">
		<div class="bz-cat-hero" style="position:relative; height:220px; background:linear-gradient(130deg,#e8edf8 0%,#dde4f2 60%,#d0daea 100%); border-radius:16px; overflow:hidden; display:flex; align-items:center;">
			<div class="bz-cat-hero-text" style="position:relative; z-index:2; padding:0 48px; max-width:480px;">
				<div style="font-size:10px; font-weight:700; letter-spacing:0.14em; color:var(--color-primary); text-transform:uppercase; margin-bottom:8px;">Categoría</div>
				<h1 style="font-size:32px; font-weight:700; color:var(--color-text); line-height:1.15; margin-bottom:10px;">{categoryName}</h1>
				<p style="font-size:13.5px; color:var(--color-text-muted); line-height:1.6;">Monta tu celular en cualquier instrumento. Diseñados con impresión 3D.</p>
			</div>
		</div>
	</div>


	<!-- MAIN CONTENT -->
	<div class="bz-section-wrap bz-cat-main" style="max-width:1200px; margin:0 auto; padding:20px 32px 64px; display:grid; grid-template-columns:200px 1fr; gap:24px; align-items:start;">

		<!-- SIDEBAR -->
		<div class="bz-cat-sidebar" style="background:white; border-radius:12px; border:1px solid var(--color-border-soft); padding:20px; position:sticky; top:94px;">
			<div style="font-size:13px; font-weight:700; color:var(--color-text); margin-bottom:16px; display:flex; align-items:center; justify-content:space-between;">
				Filtro
				<button type="button" style="font-size:11px; font-weight:500; color:var(--color-primary); background:none; border:none; cursor:pointer; ">Limpiar</button>
			</div>

			<div style="margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--color-surface-muted);">
				<div style="font-size:11px; font-weight:700; color:var(--color-text-soft); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:10px;">Categoría</div>
				<div style="display:flex; flex-direction:column; gap:3px;">
					{categoriasDb.map((c) => (
						<a
							href={`/catalogo/${c.slug}`}
							style={`display:block; padding:6px 8px; border-radius:6px; text-decoration:none; font-size:13px; ${c.id === categoriaActual?.id ? 'background:var(--color-primary-light); color:var(--color-primary); font-weight:700;' : 'color:var(--color-text-soft); font-weight:400;'}`}
						>{c.nombre}</a>
					))}
				</div>
			</div>

		</div>

		<!-- PRODUCT GRID -->
		<div>
			<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
				<span style="font-size:13px; color:var(--color-text-muted);"><span style="font-weight:600; color:var(--color-text);">{matched.length}</span> productos</span>
				<div style="display:flex; align-items:center; gap:9px;">
					<span style="font-size:13px; color:var(--color-text-muted);">Ordenar por</span>
					<div class="bz-sort-wrap">
						<select class="bz-sort-select">
							<option>Relevancia</option>
							<option>Precio: menor a mayor</option>
							<option>Precio: mayor a menor</option>
							<option>Más nuevos</option>
						</select>
						<svg class="bz-sort-arrow" width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="var(--color-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</div>
				</div>
			</div>
			<div class="bz-cat-product-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:14px;">
				{products.map((p) => (
					<ProductCard href={p.href} nombre={p.nombre} precio={p.precio} precioOriginal={p.precioOriginal} />
				))}
			</div>

			<Pagination currentPage={currentPage} totalPages={totalPages} basePath={`/catalogo/${categoria}`} />
		</div>

	</div>
</PublicLayout>

<style>
	.bz-sort-wrap {
		position: relative;
		display: inline-flex;
		align-items: center;
	}
	.bz-sort-select {
		appearance: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		padding: 9px 34px 9px 15px;
		border: 1.5px solid var(--color-border);
		border-radius: 10px;
		font-size: 13px;
		font-weight: 500;
		color: var(--color-text);
		background: white;
		cursor: pointer;
		outline: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
	}
	.bz-sort-select:hover {
		border-color: var(--color-primary-border);
		background: var(--color-primary-light);
	}
	.bz-sort-select:focus-visible {
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px var(--color-primary-light);
	}
	.bz-sort-arrow {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		pointer-events: none;
		transition: transform 0.15s ease;
	}
	.bz-sort-select:focus ~ .bz-sort-arrow {
		transform: translateY(-50%) rotate(180deg);
	}

	@media (max-width: 860px) {
		.bz-cat-hero {
			height: auto !important;
			min-height: 200px !important;
			flex-direction: column !important;
			align-items: flex-start !important;
			padding: 24px 0 !important;
		}
		.bz-cat-hero-text {
			padding: 0 20px !important;
			max-width: 100% !important;
		}
		.bz-cat-main {
			grid-template-columns: 1fr !important;
		}
		.bz-cat-sidebar {
			position: static !important;
		}
		.bz-cat-product-grid {
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)) !important;
		}
	}
	@media (max-width: 420px) {
		.bz-cat-product-grid {
			gap: 10px !important;
		}
	}
</style>
