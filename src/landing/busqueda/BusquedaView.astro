---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import ProductCard from '@landing/producto/ProductCard.astro';
import Pagination from './Pagination.astro';
import { getProductosPublicados } from '@shared/lib/productos/productoService';
import { getCategorias } from '@shared/lib/categorias/categoriaService';
import { productoUrl } from '@shared/lib/productos/productoUrl';

interface Props {
  query?: string;
}

const { query = '' } = Astro.props;

// El buscador no debe ofrecer borradores/inactivos — se filtra a nivel de
// query (ver getProductosPublicados), el texto se sigue matcheando en JS.
const [productosDb, categoriasDb] = await Promise.all([getProductosPublicados(), getCategorias()]);
const q = query.trim().toLowerCase();
const matched = q
  ? productosDb.filter((p) => p.nombre.toLowerCase().includes(q) || p.keywords.toLowerCase().includes(q))
  : productosDb;

// Categorías reales (mismo instrumento que /admin/categorias y el mega
// menú del Header) — se listan TODAS. Cada una navega a /catalogo/[slug],
// igual que al hacer click en esa categoría desde el Header.
const categoryFilters = categoriasDb.map((c) => ({ id: c.id, nombre: c.nombre, slug: c.slug }));

const PAGE_SIZE = 12;
const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
const requestedPage = Number(Astro.url.searchParams.get('page')) || 1;
const currentPage = Math.min(Math.max(requestedPage, 1), totalPages);
const pageItems = matched.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

const results = pageItems.map((p) => ({ href: productoUrl(p), nombre: p.nombre, precio: p.precio, precioOriginal: p.precioOriginal ?? undefined }));
---

<PublicLayout title={`Buscar "${query}" — Barzol`}>
	<!-- SEARCH HEADER -->
	<div style="background:white; border-bottom:1px solid var(--color-border-soft); padding:16px 0;">
		<div style="max-width:1200px; margin:0 auto; padding:0 32px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
			<div>
				<p style="font-size:13px; color:var(--color-text-muted); margin-bottom:2px;">Mostrando resultados para</p>
				<h1 style="font-size:20px; font-weight:700; color:var(--color-text);">"{query || 'todos los productos'}" <span style="font-size:14px; font-weight:400; color:var(--color-text-muted);">— {matched.length} resultados</span></h1>
			</div>
			<div style="display:flex; align-items:center; gap:9px;">
				<span style="font-size:13px; color:var(--color-text-muted);">Ordenar por</span>
				<div class="bz-sort-wrap">
					<select class="bz-sort-select">
						<option>Relevancia</option>
						<option>Precio: menor a mayor</option>
						<option>Precio: mayor a menor</option>
						<option>Más nuevos</option>
					</select>
					<svg class="bz-sort-arrow" width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="var(--color-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</div>
			</div>
		</div>
	</div>

	<!-- MAIN CONTENT -->
	<div class="bz-search-main bz-section-wrap" style="max-width:1200px; margin:0 auto; padding:24px 32px 64px; display:grid; grid-template-columns:220px 1fr; gap:28px; align-items:start;">

		<!-- SIDEBAR FILTROS -->
		<div class="bz-search-sidebar" style="background:white; border-radius:12px; border:1px solid var(--color-border-soft); padding:20px; position:sticky; top:94px;">
			<div style="font-size:14px; font-weight:700; color:var(--color-text); margin-bottom:18px; display:flex; align-items:center; justify-content:space-between;">
				Filtrossss
				<button type="button" style="font-size:11px; font-weight:500; color:var(--color-primary); background:none; border:none; cursor:pointer; ">Limpiar</button>
			</div>

			{categoryFilters.length > 0 && (
				<div style="margin-bottom:20px; padding-bottom:20px; border-bottom:1px solid var(--color-surface-muted);">
					<div style="font-size:11px; font-weight:700; color:var(--color-text-soft); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:12px;">Categoría</div>
					<div style="display:flex; flex-direction:column; gap:9px;">
						{categoryFilters.map((c) => (
							<a href={`/catalogo/${c.slug}`} style="display:block; text-decoration:none; font-size:13px; color:var(--color-text-soft);">
								{c.nombre}
							</a>
						))}
					</div>
				</div>
			)}
		</div>

		<!-- RESULTS GRID -->
		<div>
			{results.length > 0 ? (
				<>
					<div class="bz-search-results-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:14px;">
						{results.map((p) => (
							<ProductCard href={p.href} nombre={p.nombre} precio={p.precio} precioOriginal={p.precioOriginal} />
						))}
					</div>

					<Pagination currentPage={currentPage} totalPages={totalPages} basePath="/busqueda" extraParams={query.trim() ? { q: query.trim() } : {}} />
				</>
			) : (
				<div class="bz-empty-state" style="display:flex; flex-direction:column; align-items:center; text-align:center; background:white; border:1px solid var(--color-border-soft); border-radius:14px; padding:64px 32px;">
					<div style="width:72px; height:72px; border-radius:50%; background:var(--color-surface-soft); display:flex; align-items:center; justify-content:center; margin-bottom:22px;">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none">
							<circle cx="10.5" cy="10.5" r="6.5" stroke="var(--color-text-faint)" stroke-width="1.8"></circle>
							<path d="M20 20l-4.35-4.35" stroke="var(--color-text-faint)" stroke-width="1.8" stroke-linecap="round"></path>
							<path d="M8 10.5h5" stroke="var(--color-text-faint)" stroke-width="1.8" stroke-linecap="round"></path>
						</svg>
					</div>
					<h2 style="font-size:17px; font-weight:700; color:var(--color-text); margin-bottom:8px;">No encontramos resultados</h2>
					<p style="font-size:13.5px; color:var(--color-text-muted); line-height:1.6; max-width:360px; margin-bottom:26px;">
						{query
							? <>No hay productos que coincidan con <strong style="color:var(--color-text-soft);">"{query}"</strong>. Probá con otra palabra o revisá la ortografía.</>
							: <>No hay productos que coincidan con los filtros seleccionados.</>}
					</p>
					<div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:center;">
						<a href="/busqueda" style="padding:10px 20px; background:var(--color-primary); color:white; font-size:13px; font-weight:600; text-decoration:none; border-radius:9px;">Ver todos los productos</a>
						<a href="/" style="padding:10px 20px; background:white; border:1.5px solid var(--color-border); color:var(--color-text-soft); font-size:13px; font-weight:500; text-decoration:none; border-radius:9px;">Volver al inicio</a>
					</div>
				</div>
			)}
		</div>
	</div>
</PublicLayout>

<style>
	.bz-sort-wrap {
		position: relative;
		display: inline-flex;
		align-items: center;
	}
	.bz-sort-select {
		appearance: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		padding: 9px 34px 9px 15px;
		border: 1.5px solid var(--color-border);
		border-radius: 10px;
		font-size: 13px;
		font-weight: 500;
		color: var(--color-text);
		background: white;
		cursor: pointer;
		outline: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
	}
	.bz-sort-select:hover {
		border-color: var(--color-primary-border);
		background: var(--color-primary-light);
	}
	.bz-sort-select:focus-visible {
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px var(--color-primary-light);
	}
	.bz-sort-arrow {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		pointer-events: none;
		transition: transform 0.15s ease;
	}
	.bz-sort-select:focus ~ .bz-sort-arrow {
		transform: translateY(-50%) rotate(180deg);
	}

	@media (max-width: 860px) {
		.bz-search-main {
			grid-template-columns: 1fr !important;
		}
		.bz-search-sidebar {
			position: static !important;
		}
		.bz-search-results-grid {
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)) !important;
		}
	}
	@media (max-width: 420px) {
		.bz-search-results-grid {
			gap: 10px !important;
		}
	}
</style>
