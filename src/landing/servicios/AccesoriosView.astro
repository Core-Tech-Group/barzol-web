---
import { Image } from 'astro:assets';
import PublicLayout from '@landing/layout/PublicLayout.astro';
import GalleryLightbox from './GalleryLightbox.tsx';
import { getGaleria } from '@shared/lib/galeria/galeriaService';
import fotoNombreFirma from '@/assets/personalizado-nombre-firma.png';
import fotoLogoBanda from '@/assets/personalizado-logo-banda.png';
import fotoNombreDiseno from '@/assets/personalizado-nombre-diseno.png';

// Las tres sordinas del hero, de izquierda a derecha. La del medio va sobre el
// arco destacado (más alto y azulado). Viven en el repo: son parte del diseño.
const fotosHero = [
  { src: fotoNombreFirma, alt: 'Sordina personalizada con nombre y firma' },
  { src: fotoLogoBanda, alt: 'Sordina personalizada con el logo de una banda' },
  { src: fotoNombreDiseno, alt: 'Sordina personalizada con nombre y diseño' },
];

const galeriaDb = await getGaleria('accesorios');
const galeria = galeriaDb
  .slice()
  .sort((a, b) => a.orden - b.orden)
  // SPEC-905 REQ-982 — la URL viajaba hasta acá y se tiraba.
  .map((g) => ({ name: g.titulo, imagenUrl: g.imagenUrl }));

const proceso = [
  { n: '1', title: 'Nos contactas', desc: 'Cuéntanos tu proyecto por WhatsApp o email' },
  { n: '2', title: 'Cotizamos', desc: 'Te enviamos precio y tiempo estimado' },
  { n: '3', title: 'Fabricamos', desc: 'Producción con impresión 3D, a tu medida' },
  { n: '4', title: 'Te lo enviamos', desc: 'Despacho a nivel nacional e internacional' },
];
---

<PublicLayout title="Accesorios personalizados — Barzol">
	<!-- HERO — fondo claro de la paleta (a diferencia de las otras páginas de
	     servicios, que usan el azul oscuro) y tres ejemplos sobre arcos. -->
	<div class="bz-acc-hero">
		<div class="bz-acc-dots" aria-hidden="true"></div>
		<div class="bz-acc-inner">
			<div class="bz-acc-text">
				<h1>Accesorios personalizados</h1>
				<p><strong>¡Hazlo único!</strong><br />Personalizamos tu soporte, sordina o accesorio con tu nombre, para que lleves algo exclusivo y hecho especialmente para ti.</p>
			</div>
			<div class="bz-acc-arcs">
				{fotosHero.map((foto, i) => (
					<div class:list={['bz-acc-arc', { 'is-mid': i === 1 }]}>
						<Image src={foto.src} alt={foto.alt} widths={[200, 400]} sizes="(max-width: 768px) 28vw, 170px" loading="eager" />
					</div>
				))}
			</div>
		</div>
	</div>

	<!-- GALERÍA -->
	<div id="servicios" style="background:white; padding:64px 32px 16px;">
		<div style="max-width:1200px; margin:0 auto;">
			<div style="text-align:center; margin-bottom:48px;">
				<div style="font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-primary); margin-bottom:12px;">Galería</div>
				<h2 style="font-size:34px; font-weight:700; color:var(--color-text); line-height:1.2;">Nuestros trabajos personalizados</h2>
			</div>

			<div style="margin-bottom:40px;">
				<GalleryLightbox items={galeria} client:load />
			</div>
		</div>
	</div>

</PublicLayout>

<style>
	/* ---------- Hero con arcos ---------- */
	.bz-acc-hero {
		position: relative;
		overflow: hidden;
		/* Dos tonos: casi blanco del lado del texto (se lee mejor) que pasa a
		   celeste detrás de las fotos (las enmarca). Se separa de las páginas de
		   servicios oscuras sin salirse de la paleta. */
		background: linear-gradient(90deg, #f8fafd 0%, #eef3fa 42%, #d5e3f7 100%);
	}
	/* Textura de puntos solo del lado de las fotos: se desvanece hacia el texto. */
	.bz-acc-dots {
		position: absolute;
		inset: 0;
		background-size: 18px 18px;
		-webkit-mask-image: linear-gradient(90deg, transparent 35%, #000 80%);
		mask-image: linear-gradient(90deg, transparent 35%, #000 80%);
		pointer-events: none;
	}
	.bz-acc-inner {
		position: relative;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 32px;
		min-height: 310px;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 48px;
		align-items: end;
	}
	.bz-acc-text {
		align-self: center;
		padding: 42px 0;
		max-width: 460px;
	}
	.bz-acc-text h1 {
		font-size: 32px;
		font-weight: 700;
		color: var(--color-navy-dark, #0f1e46);
		line-height: 1.2;
		margin-bottom: 12px;
	}
	.bz-acc-text p {
		font-size: 15px;
		color: var(--color-text-body);
		line-height: 1.65;
	}
	.bz-acc-text strong {
		color: var(--color-primary);
	}
	/* Los arcos se apoyan en el borde inferior del hero. */
	.bz-acc-arcs {
		display: flex;
		align-items: flex-end;
		gap: 18px;
	}
	.bz-acc-arc {
		width: 168px;
		height: 210px;
		border-radius: 84px 84px 0 0;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.25));
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 36px;
		box-sizing: border-box;
	}
	.bz-acc-arc.is-mid {
		height: 258px;
		padding-top: 40px;
		background: linear-gradient(180deg, rgba(var(--color-primary-rgb), 0.16), rgba(var(--color-primary-rgb), 0.04));
	}
	.bz-acc-arc :global(img) {
		width: 142px;
		height: 132px;
		object-fit: contain;
		filter: drop-shadow(0 14px 14px rgba(15, 30, 70, 0.22));
	}
	.bz-acc-arc.is-mid :global(img) {
		width: 158px;
		height: 148px;
	}

	@media (max-width: 1000px) {
		.bz-acc-inner {
			gap: 28px;
		}
		.bz-acc-arcs {
			gap: 12px;
		}
		.bz-acc-arc {
			width: 130px;
			height: 164px;
			padding-top: 26px;
		}
		.bz-acc-arc.is-mid {
			height: 200px;
		}
		.bz-acc-arc :global(img),
		.bz-acc-arc.is-mid :global(img) {
			width: 110px;
			height: 102px;
		}
	}
	/* Móvil: el texto arriba y los arcos debajo, centrados. */
	@media (max-width: 768px) {
		/* El degradado acompaña la disposición: claro arriba (texto) y
		   celeste abajo (fotos). */
		.bz-acc-hero {
			background: linear-gradient(180deg, #f8fafd 0%, #eef3fa 45%, #d5e3f7 100%);
		}
		.bz-acc-inner {
			grid-template-columns: 1fr;
			gap: 8px;
			padding: 0 20px;
			min-height: 0;
		}
		.bz-acc-text {
			padding: 28px 0 10px;
		}
		.bz-acc-text h1 {
			font-size: 26px;
		}
		.bz-acc-arcs {
			justify-content: center;
			gap: 10px;
		}
		.bz-acc-arc {
			width: 30%;
			max-width: 140px;
			height: 130px;
			padding-top: 20px;
		}
		.bz-acc-arc.is-mid {
			height: 156px;
			padding-top: 24px;
		}
		.bz-acc-arc :global(img),
		.bz-acc-arc.is-mid :global(img) {
			width: 82%;
			height: auto;
		}
		.bz-acc-dots {
			-webkit-mask-image: linear-gradient(180deg, transparent 30%, #000 85%);
			mask-image: linear-gradient(180deg, transparent 30%, #000 85%);
		}
	}

	.cta-final-primary:hover {
		background: var(--color-success-dark);
	}
	.cta-final-secondary:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	@media (max-width: 860px) {
		.bz-serv-gallery {
			grid-template-columns: 1fr 1fr !important;
		}
		.bz-serv-proceso {
			grid-template-columns: 1fr 1fr !important;
			gap: 28px !important;
		}
		.bz-serv-proceso-line {
			display: none !important;
		}
		.bz-cta-final {
			flex-direction: column !important;
			align-items: flex-start !important;
		}
		.bz-cta-final-btns {
			width: 100% !important;
			flex-wrap: wrap !important;
		}
		.bz-cta-final-btns a {
			flex: 1 1 200px !important;
			justify-content: center !important;
		}
	}
	@media (max-width: 480px) {
		.bz-serv-gallery {
			grid-template-columns: 1fr !important;
		}
		.bz-serv-proceso {
			grid-template-columns: 1fr !important;
		}
	}
</style>
