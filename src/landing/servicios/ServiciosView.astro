---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import WhatsAppIcon from '@landing/shared/WhatsAppIcon.astro';
import GalleryLightbox from './GalleryLightbox.tsx';
import { getGaleria } from '@shared/lib/galeria/galeriaService';

const galeriaDb = await getGaleria('accesorios');
const galeria = galeriaDb
  .slice()
  .sort((a, b) => a.orden - b.orden)
  // SPEC-905 REQ-982 — la URL viajaba hasta acá y se tiraba.
  .map((g) => ({ name: g.titulo, imagenUrl: g.imagenUrl }));

const proceso = [
  { n: '1', title: 'Nos contactas', desc: 'Cuéntanos tu proyecto por WhatsApp o email' },
  { n: '2', title: 'Cotizamos', desc: 'Te enviamos precio y tiempo estimado' },
  { n: '3', title: 'Fabricamos', desc: 'Producción con impresión 3D, a tu medida' },
  { n: '4', title: 'Te lo enviamos', desc: 'Despacho a nivel nacional e internacional' },
];
---

<PublicLayout title="Servicios — Barzol">
	<!-- HERO -->
	<div style="position:relative; padding:80px 32px; overflow:hidden; background:var(--gradient-hero-dark);">
		<div style="max-width:1200px; margin:0 auto; position:relative; z-index:1;">
			<div style="display:inline-flex; align-items:center; gap:8px; padding:5px 14px; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.22); border-radius:99px; font-size:11px; font-weight:600; letter-spacing:0.08em; color:white; text-transform:uppercase; margin-bottom:14px; white-space:nowrap;">
				<svg width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 002 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="white" stroke-width="2"></path></svg>
				Hecho a tu medida
			</div>
			<h1 style="font-size:32px; font-weight:700; color:white; line-height:1.2; margin-bottom:10px;">Accesorios personalizados</h1>
			<p style="font-size:15px; color:rgba(255,255,255,0.9); line-height:1.6; max-width:560px;">Grabamos el nombre, logo o detalle especial que quieras en tu soporte, sordina o accesorio, con impresión 3D.</p>
		</div>
	</div>

	<!-- GALERÍA -->
	<div id="servicios" style="background:white; padding:64px 32px 16px;">
		<div style="max-width:1200px; margin:0 auto;">
			<div style="text-align:center; margin-bottom:48px;">
				<div style="font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-primary); margin-bottom:12px;">Galería</div>
				<h2 style="font-size:34px; font-weight:700; color:var(--color-text); line-height:1.2;">Nuestros trabajos personalizados</h2>
			</div>

			<div style="margin-bottom:40px;">
				<GalleryLightbox items={galeria} client:load />
			</div>
		</div>
	</div>

</PublicLayout>

<style>
	.cta-final-primary:hover {
		background: var(--color-success-dark);
	}
	.cta-final-secondary:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	@media (max-width: 860px) {
		.bz-serv-gallery {
			grid-template-columns: 1fr 1fr !important;
		}
		.bz-serv-proceso {
			grid-template-columns: 1fr 1fr !important;
			gap: 28px !important;
		}
		.bz-serv-proceso-line {
			display: none !important;
		}
		.bz-cta-final {
			flex-direction: column !important;
			align-items: flex-start !important;
		}
		.bz-cta-final-btns {
			width: 100% !important;
			flex-wrap: wrap !important;
		}
		.bz-cta-final-btns a {
			flex: 1 1 200px !important;
			justify-content: center !important;
		}
	}
	@media (max-width: 480px) {
		.bz-serv-gallery {
			grid-template-columns: 1fr !important;
		}
		.bz-serv-proceso {
			grid-template-columns: 1fr !important;
		}
	}
</style>
