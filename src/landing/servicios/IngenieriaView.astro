---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import WhatsAppIcon from '@landing/shared/WhatsAppIcon.astro';
import GalleryLightbox from './GalleryLightbox.tsx';
import HeroServicio from './HeroServicio.astro';
import ImagenOptimizada from '@landing/shared/ImagenOptimizada.astro';
import { getGaleria } from '@shared/lib/galeria/galeriaService';

const galeriaDb = await getGaleria('trabajos');
const galeria = galeriaDb
  .slice()
  .sort((a, b) => a.orden - b.orden)
  // SPEC-905 REQ-982 — la URL viajaba hasta acá y se tiraba.
  .map((g) => ({ name: g.titulo, imagenUrl: g.imagenUrl }));

const proceso = [
  { n: '1', title: 'Nos contactas', desc: 'Cuéntanos qué pieza necesitás por WhatsApp o email' },
  { n: '2', title: 'Diseño CAD/CAE', desc: 'Modelamos la pieza con software profesional, ajustada a tu instrumento' },
  { n: '3', title: 'Fabricamos', desc: 'Producción con impresión 3D y control de calidad antes del envío' },
  { n: '4', title: 'Te lo enviamos', desc: 'Despacho a nivel nacional e internacional' },
];
---

<PublicLayout title="Trabajos de ingeniería avanzada — Barzol">
	<!-- HERO — misma altura que Accesorios y Escaneo; la foto a la derecha, a
	     toda la altura, unida al azul con un degradado. -->
	<HeroServicio titulo="Trabajos de ingeniería avanzada" arco="clamp(120px, 13.5vw, 210px)" arcoMovil="min(27vw, 130px)" altoMedia={1.5} zonaClara={false}>
		Convertimos piezas reales en modelos digitales de precisión mediante escaneo 3D, ingeniería inversa y diseño CAD/CAE, para fabricar repuestos y piezas a medida.
		<div class="bz-ing-foto" slot="media">
			<div class="bz-ing-fundido" aria-hidden="true"></div>
			<ImagenOptimizada nombre="ingenieria-hero" alt="Ingeniero de Barzol comparando una pieza metálica con su modelo escaneado en 3D" sizes="(max-width: 768px) 100vw, 660px" loading="eager" />
		</div>
	</HeroServicio>

	<!-- GALERÍA -->
	<div id="servicios" class="bz-section-wrap" style="background:white; padding:64px 32px;">
		<div style="max-width:1200px; margin:0 auto;">
			<div style="text-align:center; margin-bottom:48px;">
				<div style="font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-primary); margin-bottom:12px;">Galería</div>
				<h2 style="font-size:34px; font-weight:700; color:var(--color-text); line-height:1.2;">Nuestros trabajos de ingeniería</h2>
			</div>

			<GalleryLightbox items={galeria} client:load />
		</div>
	</div>
</PublicLayout>

<style>
	/* ---------- Foto del hero ---------- */
	/* El degradado empieza al 35% del ancho, igual que el de Accesorios, o
	   donde termina el texto (72px + 440px) si eso queda más a la derecha: nunca
	   lo tapa. La foto se apoya a la
	   derecha, a toda la altura del hero (--alto-hero, lo da HeroServicio) y un
	   18% más grande que su tamaño completo (1672x941 = 1.777): se recorta un
	   poco por abajo (la regla). Lo que queda a su izquierda es un degradado
	   del azul al blanco del fondo de la foto, que termina justo donde ella
	   empieza. */
	.bz-ing-foto {
		/* Siempre deja al menos 130px de degradado: en pantallas angostas la
		   foto cede ancho (recorta los costados) antes que pegarse al azul. */
		--foto-ancho: min(calc(var(--alto-hero) * 1.777 * 1.18), calc(100% - 130px));
		--puente: calc(100% - var(--foto-ancho));
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: min(65%, calc(100% - 512px));
		overflow: hidden;
		/* Azul → blanco de la foto calculado en OKLab con curva suave, y el medio
		   con un 35% menos de color: pasa por grises pizarra, como el degradado
		   de Accesorios, en vez de por celestes. */
		background: linear-gradient(
			90deg,
			#0f1e46 0,
			#15244a calc(var(--puente) * 0.1),
			#253354 calc(var(--puente) * 0.2),
			#3e4a65 calc(var(--puente) * 0.3),
			#5d677b calc(var(--puente) * 0.4),
			#808797 calc(var(--puente) * 0.5),
			#a3a9b5 calc(var(--puente) * 0.6),
			#c5c9d2 calc(var(--puente) * 0.7),
			#e2e4e9 calc(var(--puente) * 0.8),
			#f6f7f9 calc(var(--puente) * 0.9),
			#fefefe var(--puente)
		);
	}
	.bz-ing-foto :global(img) {
		position: absolute;
		top: 0;
		right: 0;
		width: var(--foto-ancho);
		height: 100%;
		object-fit: cover;
		object-position: 60% top;
		/* El borde izquierdo (130px) se funde con el degradado: sin línea de
		   corte y con una transición tan larga como la de Accesorios. */
		-webkit-mask-image: linear-gradient(90deg, transparent 0, rgba(0, 0, 0, 0.55) 60px, #000 130px);
		mask-image: linear-gradient(90deg, transparent 0, rgba(0, 0, 0, 0.55) 60px, #000 130px);
	}
	.bz-ing-fundido {
		display: none;
	}

	/* Con el texto más angosto (32px + 360px), el degradado puede empezar antes. */
	@media (max-width: 1000px) {
		.bz-ing-foto {
			width: min(65%, calc(100% - 392px));
		}
	}
	/* Móvil: debajo del texto, de borde a borde y entera. El azul baja solo
	   16px sobre el borde superior, como en Escaneo. */
	@media (max-width: 768px) {
		.bz-ing-foto {
			position: relative;
			width: auto;
			height: calc(100vw / 1.777);
			margin: 0 -20px;
			background: none;
		}
		.bz-ing-foto :global(img) {
			position: static;
			width: 100%;
			object-position: center;
			-webkit-mask-image: none;
			mask-image: none;
		}
		.bz-ing-fundido {
			display: block;
			position: absolute;
			inset: 0;
			background: linear-gradient(180deg, #0f1e46 0, rgba(15, 30, 70, 0) 5px);
		}
	}

	.cta-final-primary:hover {
		background: var(--color-success-dark);
	}
	.cta-final-secondary:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	@media (max-width: 860px) {
		.bz-serv-proceso {
			grid-template-columns: 1fr 1fr !important;
			gap: 28px !important;
		}
		.bz-serv-proceso-line {
			display: none !important;
		}
		.bz-cta-final {
			flex-direction: column !important;
			align-items: flex-start !important;
		}
		.bz-cta-final-btns {
			width: 100% !important;
			flex-wrap: wrap !important;
		}
		.bz-cta-final-btns a {
			flex: 1 1 200px !important;
			justify-content: center !important;
		}
	}
	@media (max-width: 480px) {
		.bz-serv-proceso {
			grid-template-columns: 1fr !important;
		}
	}
</style>
