---
import WhatsAppIcon from '@landing/shared/WhatsAppIcon.astro';

interface Feature {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  badge: string;
  title: string;
  description: string;
  ctaHref: string;
  ctaLabel: string;
  imagePlaceholder: string;
  features: Feature[];
  areas?: string[];
  reverse?: boolean;
}

const { badge, title, description, ctaHref, ctaLabel, imagePlaceholder, features, areas, reverse = false } = Astro.props;
const textOrder = reverse ? 2 : 1;
const mediaOrder = reverse ? 1 : 2;
---

<div style="display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center; background:var(--color-surface-alt); border:1px solid var(--color-border-soft); border-radius:16px; padding:40px; margin-bottom:32px;">
	<div style={`order:${textOrder};`}>
		<div style="display:inline-flex; align-items:center; gap:8px; padding:5px 14px; background:var(--color-primary-light); border-radius:99px; font-size:11px; font-weight:600; color:var(--color-primary); letter-spacing:0.06em; text-transform:uppercase; margin-bottom:20px;">
			{badge}
		</div>
		<h3 style="font-size:30px; font-weight:700; color:var(--color-text); line-height:1.2; margin-bottom:16px;" set:html={title} />
		<p style="font-size:15px; color:var(--color-text-muted); line-height:1.75; margin-bottom:28px;">{description}</p>

		{areas && areas.length > 0 && (
			<div style="margin-bottom:28px;">
				<div style="font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--color-text-muted); margin-bottom:12px;">Áreas de trabajo</div>
				<div style="display:flex; flex-wrap:wrap; gap:8px;">
					{areas.map((area) => (
						<div style="padding:6px 14px; background:var(--color-primary-light); border:1px solid var(--color-primary-border); border-radius:99px; font-size:12px; font-weight:500; color:var(--color-primary);">{area}</div>
					))}
				</div>
			</div>
		)}

		<a href={ctaHref} target="_blank" rel="noopener" class="service-cta" style="display:inline-flex; align-items:center; gap:9px; padding:13px 24px; background:var(--color-primary); color:white; font-size:14px; font-weight:600; text-decoration:none; border-radius:9px; box-shadow:0 6px 20px rgba(var(--color-primary-rgb),0.3);">
			<WhatsAppIcon size={16} fill="white" />
			{ctaLabel}
		</a>
	</div>

	<div style={`order:${mediaOrder}; display:flex; flex-direction:column; gap:12px;`}>
		<div style="width:100%; height:280px; border-radius:16px; background:#e5e9f0; display:flex; align-items:center; justify-content:center; text-align:center; padding:16px; color:#9aa4b2; font-size:12px;">{imagePlaceholder}</div>
		<div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
			{features.map((feat) => (
				<div style="display:flex; align-items:flex-start; gap:10px; padding:14px; background:white; border-radius:10px; border:1px solid var(--color-border-soft);">
					<div style="width:32px; height:32px; border-radius:8px; background:var(--color-primary-light); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d={feat.icon} stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</div>
					<div>
						<div style="font-size:12px; font-weight:600; color:var(--color-text); margin-bottom:2px;">{feat.title}</div>
						<div style="font-size:11px; color:var(--color-text-muted); line-height:1.45;">{feat.desc}</div>
					</div>
				</div>
			))}
		</div>
	</div>
</div>

<style>
	.service-cta:hover {
		background: var(--color-primary-dark);
	}
</style>
