---
import PublicLayout from '@landing/layout/PublicLayout.astro';
import GalleryLightbox from './GalleryLightbox.tsx';
import { getGaleria } from '@shared/lib/galeria/galeriaService';

// Tercer servicio, misma estructura que AccesoriosView e IngenieriaView: hero
// y galería administrada desde /admin/galeria-diseno.
const galeriaDb = await getGaleria('diseno');
const galeria = galeriaDb
  .slice()
  .sort((a, b) => a.orden - b.orden)
  .map((g) => ({ name: g.titulo, imagenUrl: g.imagenUrl }));
---

<PublicLayout title="Diseño CAD e impresión 3D — Barzol">
	<!-- HERO -->
	<div style="position:relative; padding:80px 32px; overflow:hidden; background:var(--gradient-hero-dark);">
		<div style="max-width:1200px; margin:0 auto; position:relative; z-index:1;">
			<h1 style="font-size:32px; font-weight:700; color:white; line-height:1.2; margin-bottom:10px;">Diseño CAD e impresión 3D</h1>
			<p style="font-size:15px; color:rgba(255,255,255,0.9); line-height:1.6; max-width:560px;">
			Ofrecemos servicios de escaneado 3D e impresión 3D para tus proyectos, digitalizando piezas y objetos con precisión para su reproducción, modificación o fabricación.
Realizamos envíos de tus impresiones 3D a todo el Perú.
			</p>
		</div>
	</div>

	
	<!-- GALERÍA -->
	<div id="servicios" style="background:white; padding:64px 32px;">
		<div style="max-width:1200px; margin:0 auto;">
			<div style="text-align:center; margin-bottom:48px;">
				<div style="font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-primary); margin-bottom:12px;">Galería</div>
				<h2 style="font-size:34px; font-weight:700; color:var(--color-text); line-height:1.2;">Nuestros diseños e impresiones</h2>
			</div>

			<GalleryLightbox items={galeria} client:load />
		</div>
	</div>
</PublicLayout>
