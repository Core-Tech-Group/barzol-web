---
import AdminLayout from '@admin/layout/AdminLayout.astro';
import GalleryAdmin, { type GalleryPhoto } from '@admin/shared/GalleryAdmin.tsx';
import { getGaleria } from '@shared/lib/galeria/galeriaService';

// Adaptador: toma la forma canónica del servicio (alineada a
// DATABASE_SCHEMA.md) y arma las props que espera GalleryAdmin. Mismo patrón
// que GaleriaAccesoriosView y GaleriaTrabajosView.
const galeriaDb = await getGaleria('diseno');
const photos: GalleryPhoto[] = galeriaDb
	.slice()
	.sort((a, b) => a.orden - b.orden)
	.map((g) => ({ id: g.id, caption: g.titulo, image: g.imagenUrl }));
---

<AdminLayout title="Admin · Galería: Escaneo e impresión 3D — Barzol" active="galeria-diseno">
	<GalleryAdmin
		client:load
		title="Galería: Escaneo e impresión 3D"
		saveConfirmMessage="Se actualizará la galería de escaneo e impresión 3D."
		initialPhotos={photos}
		tipo="diseno"
	/>
</AdminLayout>
