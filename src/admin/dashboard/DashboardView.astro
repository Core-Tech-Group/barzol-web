---
import AdminLayout from '@admin/layout/AdminLayout.astro';
import { getProductos } from '@shared/lib/productos/productoService';
import { getCategorias } from '@shared/lib/categorias/categoriaService';
import { getGaleria } from '@shared/lib/galeria/galeriaService';

interface CmsSection {
	title: string;
	desc: string;
	href: string;
	icon: 'home' | 'products' | 'cats' | 'gallery' | 'settings';
	iconBg: string;
}

const [productos, categorias, galeriaAccesorios, galeriaTrabajos] = await Promise.all([
	getProductos(),
	getCategorias(),
	getGaleria('accesorios'),
	getGaleria('trabajos'),
]);
const productosPublicados = productos.filter((p) => p.publicado).length;

const cmsSections: CmsSection[] = [
	{ title: 'Página de inicio', desc: 'Hero, banners y textos destacados', href: '/admin/inicio', icon: 'home', iconBg: 'var(--color-primary-light)' },
	{ title: 'Productos', desc: `${productosPublicados} productos publicados`, href: '/admin/productos', icon: 'products', iconBg: 'var(--color-orange-bg)' },
	{ title: 'Categorías', desc: `${categorias.length} categorías activas`, href: '/admin/categorias', icon: 'cats', iconBg: 'var(--color-success-soft-bg)' },
	{ title: 'Galería: Accesorios personalizados', desc: `${galeriaAccesorios.length} fotos publicadas`, href: '/admin/galeria-accesorios', icon: 'gallery', iconBg: 'var(--color-primary-light)' },
	{ title: 'Galería: Trabajos de ingeniería', desc: `${galeriaTrabajos.length} fotos publicadas`, href: '/admin/galeria-trabajos', icon: 'gallery', iconBg: 'var(--color-primary-light)' },
	{ title: 'Configuración', desc: 'Contacto, WhatsApp y redes', href: '#', icon: 'settings', iconBg: 'var(--color-surface-muted)' },
];

const rawToday = new Date().toLocaleDateString('es-PE', { weekday: 'long', day: 'numeric', month: 'long' });
const today = rawToday.charAt(0).toUpperCase() + rawToday.slice(1);
---

<AdminLayout title="Admin · Resumen — Barzol" active="dashboard">
	<div class="bz-topbar" style="height:68px; background:white; border-bottom:1px solid var(--color-border-soft); display:flex; align-items:center; justify-content:space-between; padding:0 32px; flex-shrink:0; gap:12px;">
		<div style="display:flex; align-items:center; gap:14px; min-width:0;">
			<button type="button" class="bz-hamburger-btn" id="dashboard-hamburger" style="align-items:center; justify-content:center; width:36px; height:36px; flex-shrink:0; border:1px solid var(--color-border); border-radius:8px; background:white; cursor:pointer;">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="var(--color-text)" stroke-width="1.8" stroke-linecap="round"></path></svg>
			</button>
			<div style="min-width:0;">
				<div style="font-size:17px; font-weight:700; color:var(--color-text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Bienvenido de nuevo</div>
				<div style="font-size:12.5px; color:var(--color-text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{today}</div>
			</div>
		</div>
		<div style="display:flex; align-items:center; gap:10px; flex-shrink:0;">
			<div style="width:38px; height:38px; border-radius:50%; background:var(--color-primary-light); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:var(--color-primary); flex-shrink:0;">A</div>
			<div class="bz-user-label">
				<div style="font-size:13px; font-weight:600; color:var(--color-text);">Administrador</div>
				<div style="font-size:11.5px; color:var(--color-text-faint);">Barzol</div>
			</div>
		</div>
	</div>

	<div class="bz-content-pad" style="flex:1; overflow-y:auto; padding:32px;">
		<div style="font-size:13px; font-weight:600; color:var(--color-text-muted); margin-bottom:14px;">Contenido del sitio</div>
		<div class="bz-cms-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-bottom:28px;">
			{cmsSections.map((sec) => (
				<a href={sec.href} class="bz-cms-card" style="display:block; background:white; border:1px solid var(--color-border-soft); border-radius:12px; padding:20px; text-decoration:none;">
					<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
						<div style={`width:40px; height:40px; border-radius:9px; background:${sec.iconBg}; display:flex; align-items:center; justify-content:center;`}>
							{sec.icon === 'home' && (
								<svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3 10l9-7 9 7" stroke="var(--color-primary)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path><path d="M5 9v11a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V9" stroke="var(--color-primary)" stroke-width="1.7" stroke-linejoin="round"></path></svg>
							)}
							{sec.icon === 'products' && (
								<svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M20 7L12 3 4 7l8 4 8-4z" stroke="var(--color-orange)" stroke-width="1.7" stroke-linejoin="round"></path><path d="M4 7v10l8 4 8-4V7" stroke="var(--color-orange)" stroke-width="1.7" stroke-linejoin="round"></path></svg>
							)}
							{sec.icon === 'cats' && (
								<svg width="19" height="19" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1.5" stroke="var(--color-success)" stroke-width="1.7"></rect><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="var(--color-success)" stroke-width="1.7"></rect><path d="M3 17h7M6.5 13.5v7" stroke="var(--color-success)" stroke-width="1.7" stroke-linecap="round"></path></svg>
							)}
							{sec.icon === 'gallery' && (
								<svg width="19" height="19" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="var(--color-primary)" stroke-width="1.7"></rect><circle cx="8.5" cy="8.5" r="1.5" stroke="var(--color-primary)" stroke-width="1.5"></circle><path d="M21 15l-5-5L5 21" stroke="var(--color-primary)" stroke-width="1.5" stroke-linejoin="round"></path></svg>
							)}
							{sec.icon === 'settings' && (
								<svg width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="var(--color-text-muted)" stroke-width="1.7"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1.08-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1.08 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linejoin="round"></path></svg>
							)}
						</div>
						<span style="font-size:11px; font-weight:600; color:var(--color-primary);">Editar →</span>
					</div>
					<div style="font-size:14.5px; font-weight:700; color:var(--color-text); margin-bottom:3px;">{sec.title}</div>
					<div style="font-size:12.5px; color:var(--color-text-muted);">{sec.desc}</div>
				</a>
			))}
		</div>
	</div>
</AdminLayout>

<style>
	.bz-cms-card:hover {
		border-color: var(--color-primary) !important;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
	}
	@media (max-width: 768px) {
		.bz-cms-grid {
			grid-template-columns: 1fr !important;
		}
		.bz-user-label {
			display: none !important;
		}
	}
	@media (max-width: 1024px) and (min-width: 769px) {
		.bz-cms-grid {
			grid-template-columns: repeat(2, 1fr) !important;
		}
	}
</style>

<script>
	document.getElementById('dashboard-hamburger')?.addEventListener('click', () => {
		document.dispatchEvent(new CustomEvent('admin:toggle-sidebar'));
	});
</script>
