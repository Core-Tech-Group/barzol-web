---
import '@shared/styles/tokens.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Iniciar sesión — Admin Barzol</title>
	</head>
	<body>
	<div style="min-height:100vh; display:grid; grid-template-columns:1fr 1fr;">

		<!-- Panel de marca -->
		<div style="position:relative; background:linear-gradient(155deg,#0d2350 0%,var(--color-primary) 55%,#2f6bb8 100%); display:flex; flex-direction:column; justify-content:space-between; padding:48px; overflow:hidden;">
			<div style="position:absolute; top:-100px; right:-100px; width:400px; height:400px; border-radius:50%; background:rgba(255,255,255,0.05); pointer-events:none;"></div>
			<div style="position:absolute; bottom:-140px; left:-60px; width:340px; height:340px; border-radius:50%; background:rgba(255,255,255,0.04); pointer-events:none;"></div>

			<div style="position:relative; z-index:1;">
				<span style="font-size:16px; font-weight:700; color:white; letter-spacing:0.01em;">BARZOL</span>
			</div>

			<div style="position:relative; z-index:1; max-width:420px; animation:fadeSlide 0.6s ease both;">
				<div style="font-size:10px; font-weight:700; letter-spacing:0.16em; color:rgba(255,255,255,0.7); text-transform:uppercase; margin-bottom:14px;">Panel administrativo</div>
				<h1 style="font-size:32px; font-weight:700; color:white; line-height:1.2; margin-bottom:16px;">Panel administrativo</h1>
				<p style="font-size:14.5px; color:rgba(255,255,255,0.78); line-height:1.7;">Acceso exclusivo para el equipo administrador.</p>
			</div>

			<div style="position:relative; z-index:1; display:flex; align-items:center; gap:10px;">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="10" rx="2" stroke="white" stroke-width="1.6"></rect><path d="M8 11V7a4 4 0 018 0v4" stroke="white" stroke-width="1.6" stroke-linecap="round"></path></svg>
				<span style="font-size:12px; color:rgba(255,255,255,0.75);">Conexión segura y cifrada</span>
			</div>
		</div>

		<!-- Panel de formulario -->
		<div style="display:flex; align-items:center; justify-content:center; padding:32px;">
			<div style="width:100%; max-width:380px;">

				<div style="margin-bottom:30px;">
					<h2 style="font-size:22px; font-weight:700; color:var(--color-text); margin-bottom:6px;">Iniciar sesión</h2>
					<p style="font-size:13.5px; color:var(--color-text-muted);">Ingresa tus credenciales de administrador</p>
				</div>

				<form id="login-form" style="display:flex; flex-direction:column; gap:16px;">
					<div id="login-error" hidden style="display:flex; align-items:center; gap:8px; padding:10px 12px; background:var(--color-danger-bg); border:1px solid var(--color-danger); border-radius:7px; font-size:12.5px; color:var(--color-danger);">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="flex-shrink:0;"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle><line x1="12" y1="8" x2="12" y2="13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></line><circle cx="12" cy="16" r="0.9" fill="currentColor"></circle></svg>
						<span id="login-error-text">Usuario o contraseña incorrectos.</span>
					</div>

					<div>
						<label for="login-username" style="display:block; font-size:12.5px; font-weight:600; color:var(--color-text-soft); margin-bottom:7px;">Usuario</label>
						<div style="position:relative;">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--color-text-faint);"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"></circle><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
							<input id="login-username" type="text" placeholder="Ingresa tu usuario" autocomplete="username" class="login-input" style="width:100%; padding:11px 14px 11px 40px; border:1.5px solid var(--color-border); border-radius:7px; font-size:14px; color:var(--color-text); background:white;" />
						</div>
					</div>

					<div>
						<label for="login-password" style="display:block; font-size:12.5px; font-weight:600; color:var(--color-text-soft); margin-bottom:7px;">Contraseña</label>
						<div style="position:relative;">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--color-text-faint);"><rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.7"></rect><path d="M8 11V7a4 4 0 018 0v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
							<input id="login-password" type="password" placeholder="••••••••" autocomplete="current-password" class="login-input" style="width:100%; padding:11px 44px 11px 40px; border:1.5px solid var(--color-border); border-radius:7px; font-size:14px; color:var(--color-text); background:white;" />
							<button type="button" id="login-toggle-password" aria-label="Mostrar contraseña" style="position:absolute; right:4px; top:50%; transform:translateY(-50%); width:32px; height:32px; background:transparent; border:none; border-radius:7px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--color-text-faint);">
								<svg id="login-eye-on" width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" stroke="currentColor" stroke-width="1.6"></path><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"></circle></svg>
								<svg id="login-eye-off" width="17" height="17" viewBox="0 0 24 24" fill="none" style="display:none;"><path d="M17.94 17.94A10.94 10.94 0 0112 19c-7 0-11-7-11-7a20.3 20.3 0 015.06-5.94M9.9 4.24A10.6 10.6 0 0112 4c7 0 11 7 11 7a20.5 20.5 0 01-2.34 3.44M14.12 14.12a3 3 0 11-4.24-4.24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path><line x1="1" y1="1" x2="23" y2="23" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line></svg>
							</button>
						</div>
					</div>

					<button type="submit" id="login-submit" disabled class="login-submit" style="width:100%; padding:13px; background:var(--color-primary-disabled); color:white; font-size:14px; font-weight:600; border:none; border-radius:7px; cursor:not-allowed; margin-top:6px; box-shadow:0 6px 20px rgba(var(--color-primary-rgb),0.28); display:flex; align-items:center; justify-content:center; gap:8px;">
						<svg id="login-spinner" width="15" height="15" viewBox="0 0 24 24" fill="none" style="display:none; animation:login-spin 0.7s linear infinite;"><circle cx="12" cy="12" r="9" stroke="rgba(255,255,255,0.35)" stroke-width="2.5"></circle><path d="M21 12a9 9 0 00-9-9" stroke="white" stroke-width="2.5" stroke-linecap="round"></path></svg>
						<span id="login-submit-label">Iniciar sesión</span>
					</button>
				</form>

				<a href="/" class="login-back-link" style="display:flex; align-items:center; justify-content:center; gap:6px; margin-top:28px; font-size:12.5px; font-weight:500; color:var(--color-text-muted); text-decoration:none;">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					Volver a la tienda
				</a>
			</div>
		</div>
	</div>
	</body>
</html>

<style>
	.login-input:focus {
		outline: none;
		border-color: var(--color-primary) !important;
		box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.12);
	}
	.login-toggle-password:hover,
	#login-toggle-password:hover {
		background: var(--color-surface-soft);
	}
	.login-submit:not(:disabled):hover {
		background: var(--color-primary-dark);
	}
	.login-back-link:hover {
		color: var(--color-primary);
	}
	@keyframes login-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}
</style>

<script>
	// TODO: reemplazar por Supabase Auth real (ver ARCHITECTURE.md — Autenticación
	// del Admin). Por ahora es un mock: siempre falla tras una espera simulada,
	// igual que el prototipo original.
	const form = document.getElementById('login-form') as HTMLFormElement;
	const usernameInput = document.getElementById('login-username') as HTMLInputElement;
	const passwordInput = document.getElementById('login-password') as HTMLInputElement;
	const submitBtn = document.getElementById('login-submit') as HTMLButtonElement;
	const submitLabel = document.getElementById('login-submit-label')!;
	const spinner = document.getElementById('login-spinner')!;
	const errorBox = document.getElementById('login-error')!;
	const toggleBtn = document.getElementById('login-toggle-password')!;
	const eyeOn = document.getElementById('login-eye-on')!;
	const eyeOff = document.getElementById('login-eye-off')!;

	function updateSubmitState() {
		const filled = usernameInput.value.trim().length > 0 && passwordInput.value.length > 0;
		submitBtn.disabled = !filled;
		submitBtn.style.background = filled ? 'var(--color-primary)' : 'var(--color-primary-disabled)';
		submitBtn.style.cursor = filled ? 'pointer' : 'not-allowed';
	}

	function clearError() {
		errorBox.hidden = true;
	}

	usernameInput.addEventListener('input', () => {
		clearError();
		updateSubmitState();
	});
	passwordInput.addEventListener('input', () => {
		clearError();
		updateSubmitState();
	});

	toggleBtn.addEventListener('click', () => {
		const showing = passwordInput.type === 'text';
		passwordInput.type = showing ? 'password' : 'text';
		eyeOn.style.display = showing ? '' : 'none';
		eyeOff.style.display = showing ? 'none' : '';
	});

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		if (submitBtn.disabled) return;

		submitBtn.disabled = true;
		spinner.style.display = '';
		submitLabel.textContent = 'Ingresando...';

		setTimeout(() => {
			spinner.style.display = 'none';
			submitLabel.textContent = 'Iniciar sesión';
			errorBox.hidden = false;
			updateSubmitState();
		}, 900);
	});
</script>
