---
import AdminLayout from '@admin/layout/AdminLayout.astro';
import ConfiguracionAdmin, { type AdminVendedor } from './ConfiguracionAdmin.tsx';
import { getVendedoresConProductos } from '@shared/lib/productos/productoService';

// Con el cliente del administrador (lo deja el middleware en locals) el conteo
// incluye los productos en borrador, que el cliente anónimo no debería ver.
const vendedores: AdminVendedor[] = await getVendedoresConProductos(Astro.locals.supabase);
---

<AdminLayout title="Admin · Configuración — Barzol" active="configuracion">
	<ConfiguracionAdmin client:load initialVendedores={vendedores} />
</AdminLayout>
