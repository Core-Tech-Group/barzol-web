---
import ErrorLayout from '@landing/layout/ErrorLayout.astro';

// Página que Astro sirve ante cualquier error no capturado en el servidor.
// El motivo por el que no usa PublicLayout está explicado en ErrorLayout.astro.
---

<ErrorLayout
	titulo="Algo salió mal"
	encabezado="Algo salió mal"
	mensaje="No pudimos cargar esta página. Es un problema nuestro, no tuyo. Volvé a intentarlo en unos minutos o escribinos por WhatsApp y te atendemos."
	icono="alerta"
	mostrarWhatsapp
/>
