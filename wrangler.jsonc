{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "barzol-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// ─── Configuración pública del sitio ──────────────────────────────────
	//
	// Estos dos valores viven acá, versionados, y NO en el panel de Cloudflare.
	// El motivo es concreto: wrangler trata este archivo como única fuente de
	// verdad al estilo terraform, así que cada `wrangler deploy` BORRA las
	// variables cargadas desde el panel. Eso tumbó el sitio tres despliegues
	// seguidos (ver BZ-34 y BZ-46 en el kanban). Declarándolas acá el problema
	// desaparece: el propio despliegue las establece y no hay paso manual que
	// recordar ni nada que se pueda borrar.
	//
	// Ninguno de los dos es secreto: el primero es la URL pública del proyecto
	// de Supabase y el segundo, el dominio público desde el que se sirven las
	// imágenes. Ambos ya viajan al navegador en cada visita.
	//
	// La anon key NO está acá: va como **Secret** en el panel. Los secretos son
	// inmunes a este problema — wrangler no los borra nunca al desplegar, sólo
	// con `wrangler secret delete`.
	"vars": {
		"BARZOL_SUPABASE_URL": "https://rnfcccnesxunjtpwahce.supabase.co",
		"BARZOL_R2_PUBLIC_URL": "https://pub-12c5101b37f34f829bbea3f12287ee9e.r2.dev"
	},
	// Protege cualquier otra variable que se cargue desde el panel a futuro.
	// Con el bloque `vars` de arriba ya es redundante para esas dos, pero
	// evita repetir el mismo accidente con una tercera.
	"keep_vars": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Bucket de contenido multimedia. Al ser un binding, el worker escribe en R2
	// sin credenciales S3 ni firma: el acceso lo concede la plataforma. En
	// `npm run dev` Cloudflare lo simula en local dentro de .wrangler/state, así
	// que se puede probar la subida sin tocar el bucket real.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "barzol-web"
		}
	],
	"observability": {
		"enabled": true
	}
}