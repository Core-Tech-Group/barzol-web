{
  "name": "barzol-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "generate-types": "wrangler types",
    "typecheck": "astro check && tsc --noEmit",
    "test": "npm run test:node && npm run test:workers",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "test:cov:workers": "vitest run --config vitest.workers.config.ts --coverage",
    "sdd:trace": "node scripts/sdd-trace.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sdd:gate": "npm run typecheck && npm run test:cov && npm run sdd:trace",
    "test:node": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.113.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
