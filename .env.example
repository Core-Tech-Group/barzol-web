# Plantilla de variables de entorno. Copiar a `.env` (ignorado por git).
#
# En local, wrangler carga este `.env` dentro del worker — el build lo confirma
# con "Using secrets defined in .env". En producción las mismas variables van en
# Cloudflare → Workers & Pages → barzol-web → Settings → Variables and Secrets.
#
# Todas son de servidor: sin el prefijo PUBLIC_, Astro no las expone al
# navegador. No renombrarlas a PUBLIC_* — filtraría los secretos al bundle.
#
# Se leen SIEMPRE con shared/lib/env/serverEnv.ts, nunca con import.meta.env
# directo (ver ARCHITECTURE.md § Variables de entorno).

# ─── Supabase (PostgreSQL + Auth del admin) ───────────────────────────────
# Panel de Supabase → Project Settings → API
BARZOL_SUPABASE_URL=https://rnfcccnesxunjtpwahce.supabase.co
BARZOL_SUPABASE_ANON_KEY=sb_publishable_3xL_oYW6Of6STNJFbqA1qA_w9EVihYQ
# Sólo para operaciones que necesiten saltarse RLS. Hoy ningún código la usa.
BARZOL_SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare R2 (contenidos multimedia) ────────────────────────────────
# El acceso de ESCRITURA no usa variables: va por el binding `MEDIA` declarado
# en wrangler.jsonc, que la plataforma concede al worker. No hay Access Key ni
# Secret que configurar, guardar ni rotar.
#
# Lo único que hace falta es la base pública de LECTURA del bucket, sin barra
# final: el dominio que sirve las imágenes al visitante. Se obtiene habilitando
# el subdominio r2.dev del bucket (R2 → barzol-web → Settings → Public
# Development URL) o conectando un dominio propio, p. ej. https://media.barzol.com
BARZOL_R2_PUBLIC_URL=
