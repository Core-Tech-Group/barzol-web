# Plantilla de variables de entorno. Copiar a `.env` y completar.
# `.env` está en .gitignore — NUNCA subir credenciales reales a este archivo.
#
# En producción estas mismas variables se cargan en
# Vercel → Project Settings → Environment Variables.
# Todas son de servidor: sin el prefijo PUBLIC_, Astro no las expone al
# navegador. No renombrarlas a PUBLIC_* — filtraría los secretos al bundle.

# ─── Supabase (PostgreSQL + Auth del admin) ───────────────────────────────
# Panel de Supabase → Project Settings → API
BARZOL_SUPABASE_URL=
BARZOL_SUPABASE_ANON_KEY=
# Sólo para operaciones que necesiten saltarse RLS. Hoy ningún código la usa.
BARZOL_SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare R2 (contenidos multimedia) ────────────────────────────────
# Panel de Cloudflare → R2 → Manage API tokens → Create User API Token
# (permiso "Object Read & Write", acotado al bucket barzol-web).
#
# El endpoint S3 NO se configura: se deriva de BARZOL_R2_ACCOUNT_ID como
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com — es el mismo ID que aparece
# en el endpoint que muestra Cloudflare al crear el token.
BARZOL_R2_ACCOUNT_ID=
BARZOL_R2_ACCESS_KEY=
BARZOL_R2_SECRET_KEY=
BARZOL_R2_BUCKET_NAME=barzol-web

# Base pública de LECTURA del bucket, sin barra final. Es el dominio que sirve
# las imágenes al visitante, no el endpoint S3 (ese sólo acepta peticiones
# firmadas). Se obtiene habilitando el subdominio r2.dev del bucket
# (R2 → barzol-web → Settings → Public Development URL) o conectando un dominio
# propio, p. ej. https://media.barzol.com
BARZOL_R2_PUBLIC_URL=
