# Configuración del despliegue local (Orange Pi + Docker + Cloudflare Zero
# Trust). Copiar a `docker/.env`, que está ignorado por git.
#
# `scripts/desplegar-local.sh` lo crea solo la primera vez y genera ahí las
# claves: no hace falta copiarlo a mano salvo que se quiera fijar valores
# propios antes del primer arranque.
#
# Nada de esto viaja al navegador. Las variables que el sitio consume están en
# `docker-compose.yml` → servicio `web`; acá viven las de la infraestructura.

# ─── URL pública del sitio ────────────────────────────────────────────────
#
# LA VARIABLE MÁS IMPORTANTE DEL ARCHIVO. Es la dirección por la que el
# visitante llega, y termina escrita DENTRO de la base: cada imagen que se sube
# guarda su URL completa a partir de este valor (igual que pasaba con el dominio
# público de R2). Cambiarla más adelante deja las imágenes ya cargadas
# apuntando al valor viejo — ver "Cambiar la URL pública" en el kanban OP-30.
#
# Con túnel de Cloudflare: el hostname público que se configuró en Zero Trust,
# con https:// y sin barra final. Ejemplo: https://barzol.midominio.com
# Sin túnel (pruebas en la red local): http://<ip-de-la-orangepi>:8110
BARZOL_PUBLIC_URL=http://localhost:8110

# ─── Túnel de Cloudflare Zero Trust ───────────────────────────────────────
#
# Token del túnel, desde Zero Trust → Networks → Tunnels → (tu túnel) →
# Install and run a connector. Es la cadena larga del comando que muestra ahí.
#
# Vacío = el sistema se levanta sin túnel, accesible sólo en la red local.
# Con valor, el script agrega el perfil `tunel` y publica el sitio.
#
# En el panel del túnel, el servicio público debe apuntar a `http://proxy:8080`.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Puertos publicados en la Orange Pi ───────────────────────────────────
#
# Elegidos tras auditar lo que ya corre en esta máquina (cognix, oftalmoplus,
# ecommerce-lentes). Ocupados y por eso evitados: 22, 80, 111, 3005, 5201, 5555,
# 6380, 8080, 8085, 8091, 9993, 11434, 27018.
#
# Sólo PUERTO_EDGE escucha en todas las interfaces — es el único ingreso del
# sistema. Los otros dos se publican en 127.0.0.1 y sirven para diagnosticar
# desde el anfitrión, no para exponer nada.
#
# PUERTO_EDGE y PUERTO_GATEWAY apuntan al MISMO contenedor (Traefik), a dos
# entrypoints distintos: el público y el interno. Ver docker/traefik/traefik.yml.
PUERTO_EDGE=8110
PUERTO_GATEWAY=8111
PUERTO_DB=8112

# ─── Base de datos ────────────────────────────────────────────────────────
POSTGRES_DB=barzol
# La genera el script al crear el archivo. No sale de la red de Docker.
POSTGRES_PASSWORD=

# ─── Claves JWT ───────────────────────────────────────────────────────────
#
# Las genera `scripts/generar-claves-jwt.mjs`. Las tres están atadas entre sí:
# las dos claves son JWT firmados con el secreto. Cambiar el secreto sin
# regenerar las claves rompe el login y toda escritura, así que se regeneran
# siempre juntas.
BARZOL_JWT_SECRET=
BARZOL_SUPABASE_ANON_KEY=
# Salta RLS. Sólo la usa el alta del admin durante el despliegue; el contenedor
# del sitio nunca la recibe.
BARZOL_SERVICE_ROLE_KEY=

# ─── Usuario administrador ────────────────────────────────────────────────
#
# El panel pide usuario, no email: la aplicación arma internamente
# `<usuario>@barzol.internal` (ver src/shared/lib/auth/authClient.ts).
# Se da de alta en el primer despliegue; después, cambiar esto no lo modifica.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador
# Vacío = el script genera una y la muestra UNA sola vez al terminar.
ADMIN_PASSWORD=
